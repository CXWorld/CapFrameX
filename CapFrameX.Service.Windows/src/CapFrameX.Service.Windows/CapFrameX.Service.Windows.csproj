<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>CapFrameX.Service.Windows.Host</RootNamespace>
    <AssemblyName>CapFrameX.Service.Windows</AssemblyName>
    <!-- A console application on purpose: started by the frontend it is launched headless, started
         on its own it keeps its console and its logs, which is the diagnostic path. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\CapFrameX.Service.Shared\src\CapFrameX.Service.Api\CapFrameX.Service.Api.csproj" />
    <ProjectReference Include="..\CapFrameX.Service.Windows.Platform\CapFrameX.Service.Windows.Platform.csproj" />
  </ItemGroup>

</Project>
