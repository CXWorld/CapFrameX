							<TextBlock Text="Overlay" FontSize="16" VerticalAlignment="Center"/>
							<TextBlock Margin="12 0 0 0" FontSize="12" VerticalAlignment="Center"
									   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
