									<Separator Margin="0 4" Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
									<StackPanel Margin="0 8 0 4">
										<TextBlock FontWeight="SemiBold" Text="{loc:Tr OverlayView_PresentMonReplayBuffer}"/>
										<TextBlock Style="{StaticResource OsdOptionsDescription}"
												   Text="{loc:Tr OverlayView_MinimumBufferingUsedToSmooth}"/>
										<Grid Margin="0 8 0 0">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*"/>
												<ColumnDefinition Width="68"/>
											</Grid.ColumnDefinitions>
											<Slider VerticalAlignment="Center" Minimum="500" Maximum="10000" TickFrequency="250"
													IsSnapToTickEnabled="True" Value="{Binding OsdReplayBufferSize, Mode=TwoWay}"/>
											<TextBlock Grid.Column="1" Margin="8 0 0 0" VerticalAlignment="Center" TextAlignment="Right"
													   Text="{Binding OsdReplayBufferSize, StringFormat={}{0} ms}"/>
										</Grid>
									</StackPanel>
								</StackPanel>

							</Border>

							<Border Style="{StaticResource OsdOptionsCard}">
								<StackPanel>
									<TextBlock Style="{StaticResource OsdOptionsSectionHeader}" Text="{loc:Tr OverlayView_ShortcutsAndTiming}"/>
									<TextBlock Style="{StaticResource OsdOptionsDescription}"
											   Text="{loc:Tr OverlayView_ConfigureOverlayControlsAndData}"/>
									<Separator Margin="0 10 0 4" Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>

									<DockPanel Margin="0 5">
										<TextBox DockPanel.Dock="Right" Width="160" Height="42"
												 materialDesign:HintAssist.Hint="{loc:Tr OverlayView_ToggleOverlay}"
												 materialDesign:HintAssist.HintOpacity=".8"
												 Style="{DynamicResource CxFloatingHintTextBox}" FontSize="14"
												 IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
												 PreviewKeyDown="OverlayHotkeyTextBox_PreviewKeyDown"
												 ToolTip="{loc:Tr OverlayView_HotkeyPressBackspaceDeleteOrEsc}">
											<Binding Path="OverlayHotkey" ElementName="OverlayViewControl" Mode="OneWay" TargetNullValue="{x:Static validation:HotkeyValidationRule.UnsetText}">
												<Binding.ValidationRules>
													<validation:HotkeyValidationRule ValidatesOnTargetUpdated="True"/>
												</Binding.ValidationRules>
											</Binding>
										</TextBox>
										<TextBlock Margin="0 0 12 0" VerticalAlignment="Center" Text="{loc:Tr OverlayView_OverlayHotkey}"/>
									</DockPanel>

									<DockPanel Margin="0 5">
										<TextBox DockPanel.Dock="Right" Width="160" Height="42"
												 materialDesign:HintAssist.Hint="{loc:Tr OverlayView_SwitchConfig}"
												 materialDesign:HintAssist.HintOpacity=".8"
												 Style="{DynamicResource CxFloatingHintTextBox}" FontSize="14"
												 IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
												 PreviewKeyDown="ConfigHotkeyTextBox_PreviewKeyDown"
												 ToolTip="{loc:Tr OverlayView_HotkeyPressBackspaceDeleteOrEsc}">
											<Binding Path="OverlayConfigHotkey" ElementName="OverlayViewControl" Mode="OneWay" TargetNullValue="{x:Static validation:HotkeyValidationRule.UnsetText}">
												<Binding.ValidationRules>
													<validation:HotkeyValidationRule ValidatesOnTargetUpdated="True"/>
												</Binding.ValidationRules>
											</Binding>
										</TextBox>
										<TextBlock Margin="0 0 12 0" VerticalAlignment="Center" Text="{loc:Tr OverlayView_ConfigHotkey}"/>
									</DockPanel>

									<DockPanel Margin="0 5">
										<TextBox DockPanel.Dock="Right" Width="160" Height="42"
												 materialDesign:HintAssist.Hint="{loc:Tr OverlayView_CyclePosition}"
												 materialDesign:HintAssist.HintOpacity=".8"
												 Style="{DynamicResource CxFloatingHintTextBox}" FontSize="14"
												 IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
												 PreviewKeyDown="OverlayPositionHotkeyTextBox_PreviewKeyDown"
												 ToolTip="{loc:Tr OverlayView_HotkeyPressBackspaceDeleteOrEsc}">
											<Binding Path="OverlayPositionHotkey" ElementName="OverlayViewControl" Mode="OneWay" TargetNullValue="{x:Static validation:HotkeyValidationRule.UnsetText}">
												<Binding.ValidationRules>
													<validation:HotkeyValidationRule ValidatesOnTargetUpdated="True"/>
												</Binding.ValidationRules>
											</Binding>
										</TextBox>
										<TextBlock Margin="0 0 12 0" VerticalAlignment="Center" Text="{loc:Tr OverlayView_PositionHotkey}"/>
									</DockPanel>

									<DockPanel Margin="0 5">
										<TextBox DockPanel.Dock="Right" Width="160" Height="42"
												 materialDesign:HintAssist.Hint="{loc:Tr OverlayView_ResetMetrics}"
												 materialDesign:HintAssist.HintOpacity=".8"
												 Style="{DynamicResource CxFloatingHintTextBox}" FontSize="14"
												 IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
												 PreviewKeyDown="ResetMetricsHotkeyTextBox_PreviewKeyDown"
												 ToolTip="{loc:Tr OverlayView_HotkeyPressBackspaceDeleteOrEsc}">
											<Binding Path="ResetMetricsHotkey" ElementName="OverlayViewControl" Mode="OneWay" TargetNullValue="{x:Static validation:HotkeyValidationRule.UnsetText}">
												<Binding.ValidationRules>
													<validation:HotkeyValidationRule ValidatesOnTargetUpdated="True"/>
												</Binding.ValidationRules>
											</Binding>
										</TextBox>
										<TextBlock Margin="0 0 12 0" VerticalAlignment="Center" Text="{loc:Tr OverlayView_ResetMetricsHotkey}"/>
									</DockPanel>

									<TextBlock Margin="0 14 0 2" FontWeight="SemiBold" Text="{loc:Tr OverlayView_UpdateIntervals}"/>
									<DockPanel Margin="0 5">
										<ComboBox DockPanel.Dock="Right" Width="160" Height="40" FontSize="14"

												  materialDesign:HintAssist.Hint="{loc:Tr OverlayView_RefreshPeriodMs}"
												  materialDesign:HintAssist.HintOpacity=".8"
												  materialDesign:HintAssist.IsFloating="True"
												  MaxDropDownHeight="200" MouseLeave="OSDRefreshPeriodComboBox_MouseLeave"
												  ItemsSource="{Binding Path=RefreshPeriodItemsSource}">
											<ComboBox.Text>
												<Binding Path="OSDRefreshPeriod" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
											</ComboBox.Text>
										</ComboBox>
										<StackPanel Margin="0 0 12 0" VerticalAlignment="Center">
											<TextBlock Text="{loc:Tr OverlayView_OverlayRefresh}"/>
											<TextBlock Style="{StaticResource OsdOptionsDescription}" Text="{loc:Tr OverlayView_OSDUpdatePeriod}"/>
										</StackPanel>
									</DockPanel>

									<DockPanel Margin="0 5">
										<ComboBox DockPanel.Dock="Right" Width="160" Height="40" FontSize="14"

												  materialDesign:HintAssist.Hint="{loc:Tr OverlayView_MetricIntervalS}"
												  materialDesign:HintAssist.HintOpacity=".8"
												  materialDesign:HintAssist.IsFloating="True"
												  MaxDropDownHeight="200" MouseLeave="MetricIntervalComboBox_MouseLeave"
												  ItemsSource="{Binding Path=MetricIntervalItemsSource}">
											<ComboBox.Text>
												<Binding Path="MetricInterval" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
											</ComboBox.Text>
										</ComboBox>
										<StackPanel Margin="0 0 12 0" VerticalAlignment="Center">
											<TextBlock Text="{loc:Tr OverlayView_RealTimeMetrics2}"/>
											<TextBlock Style="{StaticResource OsdOptionsDescription}" Text="{loc:Tr OverlayView_CalculationTimeFrame}"/>
										</StackPanel>
									</DockPanel>
								</StackPanel>
							</Border>
						</StackPanel>
					</Grid>
				</ScrollViewer>
			</TabItem>
		</TabControl>
	</Grid>
</UserControl>
