<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                    xmlns:ctrls="clr-namespace:CapFrameX.View.Controls">
    <Thickness x:Key="CxTabContentMargin">0,8,0,0</Thickness>

    <!--Tabs line up on the left above the content, each as wide as its header. MDIX's default
        (HorizontalContentAlignment Stretch) hosts them in a uniform grid across the whole control.-->
    <Style x:Key="CxTabControl"
           TargetType="{x:Type TabControl}"
           BasedOn="{StaticResource MaterialDesignTabControl}">
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <DataTemplate x:Key="CxTabHeaderTemplate">
        <Border x:Name="HeaderSurface"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                Background="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Grid>
                <Border x:Name="HoverSurface"
                        Background="{DynamicResource MaterialDesign.Brush.Foreground}"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Opacity="0" />
                <Grid Margin="12 0" VerticalAlignment="Center">
                    <!--Holds the width of the selected (semibold) text, so selecting a tab does not
                        shift the tabs next to it.-->
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding}"
                               Visibility="Hidden" />
                    <TextBlock x:Name="HeaderText"
                               HorizontalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                               Text="{Binding}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
                <Setter TargetName="HoverSurface" Property="Opacity" Value="0.1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Setter TargetName="HeaderText" Property="Foreground" Value="White" />
                <Setter TargetName="HeaderText" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="False">
                <Setter TargetName="HeaderSurface" Property="Opacity" Value="0.38" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--A tab is as wide as its header text, without a MinWidth. Text beyond MaxWidth, typically a
        long translation, ends in an ellipsis and the tool tip shows all of it; headers that fit
        get no tool tip.-->
    <Style x:Key="CxTabHeaderItem"
           TargetType="{x:Type TabItem}"
           BasedOn="{StaticResource MaterialDesignNavigationRailTabItem}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MaxWidth" Value="200" />
        <Setter Property="Height" Value="25" />
        <Setter Property="Margin" Value="0 0 6 0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HeaderTemplate" Value="{StaticResource CxTabHeaderTemplate}" />
        <Setter Property="ToolTip" Value="{Binding Header, RelativeSource={RelativeSource Self}}" />
        <Setter Property="ctrls:TrimmedTextToolTip.IsEnabled" Value="True" />
        <Setter Property="materialDesign:RippleAssist.Feedback" Value="Transparent" />
    </Style>
</ResourceDictionary>
