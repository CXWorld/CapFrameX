<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Thickness x:Key="CxTabContentMargin">0,8,0,0</Thickness>

    <DataTemplate x:Key="CxTabHeaderTemplate">
        <Border x:Name="HeaderSurface"
                Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                Background="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"
                CornerRadius="6"
                SnapsToDevicePixels="True">
            <Grid>
                <Border x:Name="HoverSurface"
                        Background="{DynamicResource MaterialDesign.Brush.Foreground}"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Opacity="0" />
                <TextBlock x:Name="HeaderText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           Text="{Binding}" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
                <Setter TargetName="HoverSurface" Property="Opacity" Value="0.1" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="True">
                <Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                <Setter TargetName="HeaderText" Property="Foreground" Value="White" />
                <Setter TargetName="HeaderText" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}" Value="False">
                <Setter TargetName="HeaderSurface" Property="Opacity" Value="0.38" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="CxTabHeaderItem"
           TargetType="{x:Type TabItem}"
           BasedOn="{StaticResource MaterialDesignNavigationRailTabItem}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="25" />
        <Setter Property="Margin" Value="0 0 6 0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HeaderTemplate" Value="{StaticResource CxTabHeaderTemplate}" />
        <Setter Property="materialDesign:RippleAssist.Feedback" Value="Transparent" />
    </Style>
</ResourceDictionary>
