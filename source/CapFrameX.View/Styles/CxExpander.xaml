<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

	<!--The clickable tab of a CxRailExpander; its label is the expander's Header, turned onto its
	    side. Needs to be an explicit style, not just an inline template: App.xaml installs an
	    implicit ToggleButton style (switch look, Height=32) that would otherwise cap the tab at
	    32px instead of letting it fill the rail.-->
	<Style x:Key="CxRailExpanderTab" TargetType="{x:Type ToggleButton}">
		<Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"/>
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
		<Setter Property="FontSize" Value="11"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="VerticalAlignment" Value="Stretch"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type ToggleButton}">
					<!--The whole rail stays clickable; Handle is only the part that shows.-->
					<Border x:Name="Rail" Width="28" Background="{TemplateBinding Background}">
						<!--The tooltip belongs to the visible handle instead of the full-height rail.
						    This keeps Left placement beside the control the user is actually hovering
						    and therefore inside the window without a size-dependent mouse offset.-->
						<Grid x:Name="Handle" VerticalAlignment="Center" Margin="3 0 0 0"
						      ToolTip="{TemplateBinding Tag}"
						      ToolTipService.Placement="Left">
							<!--Second helping of the same translucent overlay the rail uses. The
							    theme's HoverBackground is no help here: in the dark theme it is the
							    very same colour as FilledBackground, so stacking is what produces a
							    tone that is actually one step up in both themes.-->
							<Border CornerRadius="6 0 0 6"
							        Background="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"/>
							<!--Hover tint, kept as its own layer *behind* the label: fading a parent
							    would fade the text along with it, and filling the handle opaquely
							    swallows it. Sibling + Opacity keeps the label fully legible.-->
							<Border x:Name="HandleHover" CornerRadius="6 0 0 6" Opacity="0"
							        Background="{DynamicResource MaterialDesign.Brush.Primary}"/>
							<StackPanel HorizontalAlignment="Center" Margin="0 10">
								<!--Points the way the panel moves: left to open, right to close again.-->
								<materialDesign:PackIcon x:Name="Chevron" Kind="ChevronLeft"
								                         Width="20" Height="20" HorizontalAlignment="Center"
								                         Foreground="{DynamicResource Cx.Brush.OutlinedAction.Foreground}"/>
								<TextBlock x:Name="Label" Margin="0 6 0 0" HorizontalAlignment="Center"
								           Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
								           Foreground="{TemplateBinding Foreground}">
									<TextBlock.LayoutTransform>
										<RotateTransform Angle="90"/>
									</TextBlock.LayoutTransform>
								</TextBlock>
							</StackPanel>
						</Grid>
					</Border>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="HandleHover" Property="Opacity" Value="0.25"/>
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Chevron" Property="materialDesign:PackIcon.Kind" Value="ChevronRight"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<!--Full-height expander docked to the right window edge, used for the Analysis tab's system
	    info. The MDIX default draws the collapsed state as a bare rotated label, which reads as a
	    static caption rather than a control; this template adds the affordances that were missing:
	    a raised handle, a chevron that flips with the state, hover feedback and a hand cursor.-->
	<Style x:Key="CxRailExpander" TargetType="{x:Type Expander}">
		<Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"/>
		<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
		<Setter Property="ExpandDirection" Value="Left"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Expander}">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>
						<Border x:Name="ExpandSite" Grid.Column="0" Visibility="Collapsed"
						        Background="{TemplateBinding Background}">
							<ContentPresenter/>
						</Border>
						<!--Tag carries the tab's tooltip. Forward it to the ToggleButton so its
						    template can attach the tooltip only to the visible handle; setting it on
						    the expander would also trigger it over the expanded content.-->
						<ToggleButton x:Name="HeaderSite" Grid.Column="1"
						              Style="{StaticResource CxRailExpanderTab}"
						              Content="{TemplateBinding Header}"
						              Foreground="{TemplateBinding Foreground}"
						              Tag="{TemplateBinding Tag}"
						              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsExpanded" Value="True">
							<Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
