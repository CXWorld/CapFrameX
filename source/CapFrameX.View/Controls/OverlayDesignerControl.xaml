<UserControl x:Class="CapFrameX.View.Controls.OverlayDesignerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapFrameX.MVVM.Localization;assembly=CapFrameX.MVVM"
             xmlns:osd="clr-namespace:CapFrameX.OSD.Controls;assembly=CapFrameX.OSD.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
             Loaded="OnLoaded" Unloaded="OnUnloaded" IsVisibleChanged="OnIsVisibleChanged">
    <materialDesign:DialogHost x:Name="ProfileDialogHost" CloseOnClickAway="False">
    <DockPanel Margin="12">
        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="12,8" CornerRadius="6"
                Background="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}">
            <StackPanel>
                <WrapPanel x:Name="ProfileToolbar" VerticalAlignment="Center" IsEnabled="False">
                    <TextBlock Text="{loc:Tr OverlayEditor_Profile}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox x:Name="ProfileSelector" Width="220" MaxDropDownHeight="320"
                              DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,12,0"
                              ToolTip="{loc:Tr OverlayEditor_ProfileHint}"
                              SelectionChanged="OnProfileSelectionChanged" />
                    <Button Content="{loc:Tr OverlayEditor_New}" Click="OnNewProfile" Padding="10,4" Margin="0,0,6,0" />
                    <Button x:Name="DuplicateProfileButton" Content="{loc:Tr OverlayEditor_Duplicate}" Click="OnDuplicateProfile" Padding="10,4" Margin="0,0,6,0" />
                    <Button Content="{loc:Tr OverlayEditor_Rename}" Click="OnRenameProfile" Padding="10,4" Margin="0,0,6,0" />
                    <Button x:Name="DeleteProfileButton" Content="{loc:Tr OverlayEditor_Delete}" Click="OnDeleteProfile" Padding="10,4" Margin="0,0,14,0" />
                    <Button x:Name="SaveProfileButton" Content="{loc:Tr OverlayEditor_Save}" Click="OnSaveProfile" Padding="14,4" Margin="0,0,6,0" ToolTip="{loc:Tr OverlayEditor_SaveHint}" />
                    <Button x:Name="UseDesignButton" Content="{loc:Tr OverlayEditor_Use}" Click="OnUseDesign" Padding="14,4" Margin="0,0,12,0"
                            Visibility="Collapsed" ToolTip="{loc:Tr OverlayEditor_UseHint}" />
                    <Button Content="{loc:Tr OverlayEditor_Import}" Click="OnImportProfile" Padding="10,4" Margin="0,0,6,0" ToolTip="{loc:Tr OverlayEditor_ImportHint}" />
                    <Button x:Name="ExportProfileButton" Content="{loc:Tr OverlayEditor_Export}" Click="OnExportProfile" Padding="10,4" ToolTip="{loc:Tr OverlayEditor_ExportHint}" />
                </WrapPanel>
                <TextBlock x:Name="ProfileStatus" Text="{loc:Tr OverlayEditor_Loading}" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                <TextBlock x:Name="ProfileError" Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
            </StackPanel>
        </Border>
        <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="SourceStatus" Text="{loc:Tr OverlayEditor_SourceHelp}"
                    Margin="0,5,12,0" TextWrapping="Wrap" VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
            </StackPanel>
            <Button x:Name="RefreshSourcesButton" Grid.Column="1" Content="{loc:Tr OverlayEditor_RefreshSources}"
                VerticalAlignment="Center" Click="OnRefreshSources" Padding="12,6"
                ToolTip="{loc:Tr OverlayEditor_RefreshSourcesHint}" />
        </Grid>
        <osd:OsdEditorControl x:Name="Editor" LivePreviewChanged="OnLivePreviewChanged"
            SurfaceBrush="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"
            AccentBrush="{DynamicResource MaterialDesign.Brush.Primary}"
            Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
    </DockPanel>
    </materialDesign:DialogHost>
</UserControl>
