<UserControl x:Class="CapFrameX.View.Controls.OverlayDesignPrompt"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:CapFrameX.View.Controls">
    <StackPanel Width="440" Margin="24">
        <TextBlock x:Name="PromptTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="PromptMessage" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBox x:Name="NameInput" Margin="0,16,0,0" MaxLength="80" Visibility="Collapsed"
                 TextChanged="OnNameChanged" KeyDown="OnNameKeyDown" ToolTip="Design name (1–80 characters)" />
        <TextBlock x:Name="NameError" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap" Visibility="Collapsed"
                   Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="SecondaryButton" Content="Discard" Visibility="Collapsed" Padding="12,4" Margin="0,0,8,0"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static local:OverlayDesignPromptResult.Secondary}" />
            <Button Content="Cancel" Padding="12,4" Margin="0,0,8,0"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static local:OverlayDesignPromptResult.Cancel}" />
            <Button x:Name="ConfirmButton" Content="Save" Padding="16,4"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                    CommandParameter="{x:Static local:OverlayDesignPromptResult.Confirm}" />
        </StackPanel>
    </StackPanel>
</UserControl>
