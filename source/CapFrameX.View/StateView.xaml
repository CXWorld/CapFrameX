<UserControl x:Class="CapFrameX.View.StateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:CapFrameX.MVVM.Localization;assembly=CapFrameX.MVVM"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:prism="http://prismlibrary.com/"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:mvvm="clr-namespace:CapFrameX.MVVM.Converter;assembly=CapFrameX.MVVM"	
             xmlns:local="clr-namespace:CapFrameX.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Button.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Shadows.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.ToggleButton.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.DataGrid.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Slider.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <mvvm:BoolToVisibilityConverter x:Key="FalseToCollapsedConverter" FalseValue="Collapsed" TrueValue="Visible"/>
            <mvvm:BoolToVisibilityConverter x:Key="TrueToCollapsedConverter" FalseValue="Visible" TrueValue="Collapsed"/>
            <mvvm:ModeColorConverter x:Key="ModeColorConverter" ActiveColor="LimeGreen" InactiveColor="OrangeRed"/>
            <mvvm:ModeColorConverter x:Key="ModeColorConverterReverse" ActiveColor="OrangeRed" InactiveColor="LimeGreen"/>
            <mvvm:ModeDescriptionConverter x:Key="ModeDescriptionConverter" Seperator="|"/>
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"></Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="10*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel HorizontalAlignment="Left" Grid.Column="0" Margin="10 0 0 0" Orientation="Horizontal">
            <TextBlock Margin="0 0 5 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Capture Service:'}"/>
            <TextBlock Width="Auto" VerticalAlignment="Center" Text="{Binding IsCaptureModeActive, Converter={StaticResource ModeDescriptionConverter}, ConverterParameter=Capturing|Ready}" 
                       FontWeight="Bold" Foreground="{Binding IsCaptureModeActive, Converter={StaticResource ModeColorConverterReverse}}"></TextBlock>

            <TextBlock Margin="20 0 5 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Overlay:'}"/>
            <TextBlock Width="Auto" VerticalAlignment="Center" Text="{Binding IsOverlayActive, Converter={StaticResource ModeDescriptionConverter}, ConverterParameter=On|Off}" 
                       FontWeight="Bold" Foreground="{Binding IsOverlayActive, Converter={StaticResource ModeColorConverter}}"></TextBlock>

            <TextBlock Margin="20 0 5 0" VerticalAlignment="Center"
                       Visibility="{Binding IsHookOverlayStatusVisible, Converter={StaticResource FalseToCollapsedConverter}}"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Hook:'}"/>
            <TextBlock Width="Auto" VerticalAlignment="Center"
                       Visibility="{Binding IsHookOverlayStatusVisible, Converter={StaticResource FalseToCollapsedConverter}}"
                       Text="{Binding HookOverlayStatusText}" FontWeight="Bold"
                       Foreground="{Binding HookOverlayStatusColor}"
                       ToolTip="{Binding HookOverlayStatusToolTip}"
                       ToolTipService.ShowDuration="120000"></TextBlock>

            <TextBlock Margin="20 0 5 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Sensor Logging:'}"/>
            <TextBlock Width="Auto" VerticalAlignment="Center" Text="{Binding IsLoggingActive, Converter={StaticResource ModeDescriptionConverter}, ConverterParameter=On|Off}" 
                       FontWeight="Bold" Foreground="{Binding IsLoggingActive, Converter={StaticResource ModeColorConverter}}"></TextBlock>

            <TextBlock Margin="20 0 5 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Login Status:'}"/>
			<TextBlock Width="Auto" VerticalAlignment="Center" Text="{Binding IsLoggedIn, Converter={StaticResource ModeDescriptionConverter}, ConverterParameter= Logged in|Not logged in}" 
                       FontWeight="Bold" Foreground="{Binding IsLoggedIn, Converter={StaticResource ModeColorConverter}}"></TextBlock>

			<GridSplitter Margin="15 5 0 5" IsEnabled="False" Width="2" Visibility="{Binding IsResizableBarAnyStatusValid, Converter={StaticResource FalseToCollapsedConverter}}"/>

            <Button Margin="10 2 -5 0" Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
							VerticalAlignment="Center" HorizontalAlignment="Left"
							Width="20" Height="20"
                            Background="Transparent"
                            BorderBrush="Transparent"
							Command="{Binding UpdateStatusInfoCommand}">
                <materialDesign:PackIcon Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" Kind="Update" Width="18" Height="18" Margin="-2 -2 0 0"/>
                <Button.ToolTip>
                    <TextBlock  Text="{loc:Tr 'Update system info status'}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                </Button.ToolTip>
            </Button>

            <Grid Margin="15 0 0 0" Visibility="{Binding IsResizableBarAnyStatusValid, Converter={StaticResource FalseToCollapsedConverter}}"
                  ToolTipService.ShowDuration="120000">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0 0 5 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Resizable Bar:'}"/>
                    <TextBlock Width="Auto" VerticalAlignment="Center" Text="{Binding ResizableBarStatus}" 
                           FontWeight="Bold" Foreground="{Binding ResizableBarStatusColor}"></TextBlock>
                </StackPanel>
                <Grid.ToolTip>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Margin="5" Orientation="Horizontal" Visibility="{Binding IsResizableBarHardwareStatusValid, Converter={StaticResource FalseToCollapsedConverter}}">
                            <TextBlock Margin="0 0 5 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Resizable Bar HW:'}"/>
                            <TextBlock Width="Auto" VerticalAlignment="Center" Text="{Binding IsResizableBarHardwareEnabled, Converter={StaticResource ModeDescriptionConverter}, ConverterParameter= On|Off}" 
                           FontWeight="Bold" Foreground="{Binding IsResizableBarHardwareEnabled, Converter={StaticResource ModeColorConverter}}"></TextBlock>
                            <TextBlock Visibility="{Binding IsResizableBarHardwareStatusValid, Converter={StaticResource FalseToCollapsedConverter}}" Text="{Binding Path=ResizableBarHardwareSize, StringFormat=' (\{0\} MiB)'}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" ></TextBlock>
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal" Visibility="{Binding IsResizableBarD3DStatusValid, Converter={StaticResource FalseToCollapsedConverter}}">
                            <TextBlock Margin="0 0 5 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Resizable Bar D3D:'}"/>
                            <TextBlock Width="Auto" VerticalAlignment="Center" Text="{Binding IsResizableBarD3DEnabled, Converter={StaticResource ModeDescriptionConverter}, ConverterParameter= On|Off}" 
                           FontWeight="Bold" Foreground="{Binding IsResizableBarD3DEnabled, Converter={StaticResource ModeColorConverter}}"></TextBlock>
                            <TextBlock Visibility="{Binding IsResizableBarD3DStatusValid, Converter={StaticResource FalseToCollapsedConverter}}" Text="{Binding Path=ResizableBarD3DSize, StringFormat=' (\{0\} MiB)'}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" ></TextBlock>
                        </StackPanel>
                        <StackPanel Margin="5" Orientation="Horizontal" Visibility="{Binding IsResizableBarVulkanStatusValid, Converter={StaticResource FalseToCollapsedConverter}}">
                            <TextBlock Margin="0 0 5 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Resizable Bar Vulkan:'}"/>
                            <TextBlock Width="Auto" VerticalAlignment="Center" Text="{Binding IsResizableBarVulkanEnabled, Converter={StaticResource ModeDescriptionConverter}, ConverterParameter= On|Off}" 
                           FontWeight="Bold" Foreground="{Binding IsResizableBarVulkanEnabled, Converter={StaticResource ModeColorConverter}}"></TextBlock>
                            <TextBlock Visibility="{Binding IsResizableBarVulkanStatusValid, Converter={StaticResource FalseToCollapsedConverter}}" Text="{Binding Path=ResizableBarVulkanSize, StringFormat=' (\{0\} MiB)'}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" ></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid.ToolTip>
            </Grid>

            <TextBlock Margin="15 0 5 0" Visibility="{Binding IsGameModeStatusValid, Converter={StaticResource FalseToCollapsedConverter}}" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Win Game Mode:'}"/>
            <TextBlock Width="Auto" Visibility="{Binding IsGameModeStatusValid, Converter={StaticResource FalseToCollapsedConverter}}" VerticalAlignment="Center" Text="{Binding IsGameModeEnabled, Converter={StaticResource ModeDescriptionConverter}, ConverterParameter= On|Off}" 
                       FontWeight="Bold" Foreground="{Binding IsGameModeEnabled, Converter={StaticResource ModeColorConverter}}"></TextBlock>

            <TextBlock Margin="20 0 5 0" Visibility="{Binding IsHAGSStatusValid, Converter={StaticResource FalseToCollapsedConverter}}" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" >HAGS:</TextBlock>
            <TextBlock Width="Auto" Visibility="{Binding IsHAGSStatusValid, Converter={StaticResource FalseToCollapsedConverter}}" VerticalAlignment="Center" Text="{Binding IsHAGSEnabled, Converter={StaticResource ModeDescriptionConverter}, ConverterParameter= On|Off}" 
                       FontWeight="Bold" Foreground="{Binding IsHAGSEnabled, Converter={StaticResource ModeColorConverter}}"></TextBlock>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" Grid.Column="1" Margin="0 0 10 0" Orientation="Horizontal">
            <TextBlock Margin="0 0 6 0" VerticalAlignment="Center" FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                       Visibility="{Binding UpdateViewModel.IsDownloading, Converter={StaticResource FalseToCollapsedConverter}}"
                       Text="{Binding UpdateViewModel.DownloadProgressText}"/>
            <Button Margin="0 0 5 0" Width="20" Height="20" Padding="0"
                    Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                    Background="Transparent" BorderBrush="Transparent" VerticalAlignment="Center"
                    Visibility="{Binding UpdateViewModel.IsUpdateIndicatorVisible, Converter={StaticResource FalseToCollapsedConverter}}"
                    Command="{Binding UpdateViewModel.ShowUpdateDialogCommand}">
                <Grid>
                    <materialDesign:PackIcon Height="20" Width="20" Kind="Download"
                                             Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                             Visibility="{Binding UpdateViewModel.IsUpdateReadyToInstall, Converter={StaticResource TrueToCollapsedConverter}}"/>
                    <materialDesign:PackIcon Height="20" Width="20" Kind="Restart" Foreground="LimeGreen"
                                             Visibility="{Binding UpdateViewModel.IsUpdateReadyToInstall, Converter={StaticResource FalseToCollapsedConverter}}"/>
                </Grid>
                <Button.ToolTip>
                    <TextBlock Text="{Binding UpdateViewModel.StatusText}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                </Button.ToolTip>
            </Button>
            <materialDesign:PackIcon Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"  Kind="Information" VerticalAlignment="Center">
                <materialDesign:PackIcon.ToolTip>
                    <TextBlock Text="{Binding InfoToolTipText, UpdateSourceTrigger=Default}" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                </materialDesign:PackIcon.ToolTip>
            </materialDesign:PackIcon>
            <TextBlock Margin="5 0 0 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" Text="{loc:Tr 'Version:'}"/>
            <TextBlock Margin="5 0 0 0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"  Text="{Binding VersionString, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</UserControl>
