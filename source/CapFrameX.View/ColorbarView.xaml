														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="190"/>
														</Grid.ColumnDefinitions>
														<StackPanel VerticalAlignment="Center">
															<TextBlock Style="{StaticResource SettingsOptionTitle}" Text="Webservice port"/>
															<TextBlock Style="{StaticResource SettingsDescription}" Text="Listening port for the local remote service. Restart required."/>
														</StackPanel>
														<TextBox Grid.Column="1" Height="42" Text="{Binding WebservicePort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
																 PreviewTextInput="IntegerValidationTextBox"
																 materialDesign:HintAssist.Hint="Port"
