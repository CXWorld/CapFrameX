<UserControl x:Class="CapFrameX.View.ColorbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 xmlns:prism="http://prismlibrary.com/"
             xmlns:mvvm="clr-namespace:CapFrameX.MVVM.Converter;assembly=CapFrameX.MVVM"
             xmlns:loc="clr-namespace:CapFrameX.MVVM.Localization;assembly=CapFrameX.MVVM"
             xmlns:controls="clr-namespace:CapFrameX.View.Controls"
			 xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
			 x:Name="ColorbarViewName"
             d:DesignHeight="450" d:DesignWidth="800"
			 prism:ViewModelLocator.AutoWireViewModel="True">
	<UserControl.Resources>
		<ResourceDictionary>
			<mvvm:BoolToVisibilityConverter x:Key="FalseToCollapsedConverter" TrueValue="Visible" FalseValue="Collapsed"/>
			<mvvm:BoolToVisibilityConverter x:Key="FalseToVisibleConverter" TrueValue="Hidden" FalseValue="Visible"/>
			<mvvm:BoolToVisibilityConverter x:Key="TrueToVisibleConverter" TrueValue="Visible" FalseValue="Collapsed"/>
			<mvvm:EnumDescriptionConverter x:Key="EnumDescriptionConverter"/>
			<mvvm:AddValueConverter x:Key="AddValueConverter" Offset="-320"/>

			<Style x:Key="SettingsNavigationButton" TargetType="{x:Type RadioButton}">
				<Setter Property="Height" Value="44"/>
				<Setter Property="Margin" Value="0 2"/>
				<Setter Property="Padding" Value="12 0"/>
				<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
				<Setter Property="Background" Value="Transparent"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="Cursor" Value="Hand"/>
				<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
				<Setter Property="Template">
					<Setter.Value>
						<ControlTemplate TargetType="{x:Type RadioButton}">
							<Border x:Name="NavigationBackground"
									Background="{TemplateBinding Background}"
									CornerRadius="6"
									Padding="{TemplateBinding Padding}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="3"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<Border x:Name="SelectionIndicator"
											Width="3" Height="22" CornerRadius="2"
											VerticalAlignment="Center"
											Background="{DynamicResource MaterialDesign.Brush.Primary}"
											Opacity="0"/>
									<ContentPresenter Grid.Column="1" Margin="10 0 0 0"
												  VerticalAlignment="Center"
												  RecognizesAccessKey="True"/>
								</Grid>
							</Border>
							<ControlTemplate.Triggers>
								<Trigger Property="IsMouseOver" Value="True">
									<Setter TargetName="NavigationBackground" Property="Background"
											Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
									<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
								</Trigger>
								<Trigger Property="IsChecked" Value="True">
									<Setter TargetName="NavigationBackground" Property="Background"
											Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
									<Setter TargetName="SelectionIndicator" Property="Opacity" Value="1"/>
									<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
								</Trigger>
								<Trigger Property="IsEnabled" Value="False">
									<Setter TargetName="NavigationBackground" Property="Opacity" Value="0.45"/>
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>

			<Style x:Key="SettingsPageTitle" TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="22"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
				<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
			</Style>
			<Style x:Key="SettingsPageDescription" TargetType="{x:Type TextBlock}">
				<Setter Property="Margin" Value="0 3 0 18"/>
				<Setter Property="FontSize" Value="12"/>
				<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
				<Setter Property="TextWrapping" Value="Wrap"/>
			</Style>
			<Style x:Key="SettingsCard" TargetType="{x:Type Border}">
				<Setter Property="Margin" Value="0 0 0 12"/>
				<Setter Property="Padding" Value="18"/>
				<Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"/>
				<Setter Property="BorderThickness" Value="0"/>
				<Setter Property="CornerRadius" Value="8"/>
			</Style>
			<Style x:Key="SettingsSectionTitle" TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="15"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
				<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
			</Style>
			<Style x:Key="SettingsOptionTitle" TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="13"/>
				<Setter Property="FontWeight" Value="SemiBold"/>
				<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
			</Style>
			<Style x:Key="SettingsDescription" TargetType="{x:Type TextBlock}">
				<Setter Property="FontSize" Value="11"/>
				<Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
				<Setter Property="TextWrapping" Value="Wrap"/>
			</Style>
			<Style x:Key="SettingsCheckBox" TargetType="{x:Type CheckBox}" BasedOn="{StaticResource MaterialDesignCheckBox}">
				<Setter Property="Margin" Value="16 0 4 0"/>
				<Setter Property="VerticalAlignment" Value="Center"/>
			</Style>
		</ResourceDictionary>
	</UserControl.Resources>
	<Grid>
		<StackPanel Panel.ZIndex="1" Orientation="Horizontal" Visibility="{Binding ShowNotification, Converter={StaticResource FalseToCollapsedConverter}}" Background="Orange">
			<TextBlock VerticalAlignment="Center" Margin="10" FontWeight="Bold" FontSize="18" Text="{loc:Tr ColorbarView_ImportantMessage}"></TextBlock>
			<controls:MarkupTextBlock VerticalAlignment="Center" Margin="5" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="60"
                Width="{Binding ElementName=ColorbarViewName, Path=ActualWidth, Converter={StaticResource AddValueConverter}}"
                MarkupText="{Binding AppNotification}" Hyperlink.RequestNavigate="Hyperlink_RequestNavigate">
			</controls:MarkupTextBlock>
			<Button Margin="10" BorderThickness="0" Width="100" Height="25"
			    Command="{Binding CloseNotificationCommand}" Foreground="White" Background="LimeGreen" ToolTip="{loc:Tr ColorbarView_CloseThisMessageAndNot}">
				<TextBlock Text="{loc:Tr ColorbarView_Close}" TextWrapping="Wrap" TextAlignment="Center"/>
			</Button>
		</StackPanel>
		<materialDesign:ColorZone Mode="PrimaryMid" Foreground="White" Background="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="7*"/>
					<ColumnDefinition Width="2*"/>
				</Grid.ColumnDefinitions>
				<Grid Grid.Column="0" HorizontalAlignment="Left">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="85"/>
						<ColumnDefinition Width="0.8*"/>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1.4*"/>
						<ColumnDefinition Width="1.4*"/>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="1*"/>
					</Grid.ColumnDefinitions>
					<Image Grid.Column="0" Width="50" Height="50" Margin="5 0 5 0" Source="/Icons/CapFrameXLogoOnly.png"/>
					<RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
                        Grid.Column="1"
                        Width="120"
                        HorizontalAlignment="Center"
                        IsChecked="{Binding InfoIsChecked}"
                        Content="{loc:Tr ColorbarView_INFO}" />
					<RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
                        Grid.Column="2"
                        Width="150"
                        HorizontalAlignment="Center"
                        IsChecked="{Binding CaptureIsChecked}"
                        Content="{loc:Tr ColorbarView_CAPTURE}"
                        Visibility="{Binding IsCompatibleWithRunningOS, Converter={StaticResource FalseToCollapsedConverter}}"/>
					<RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
							 Grid.Column="3"
                                 Width="150"
                                 HorizontalAlignment="Center"
							 IsChecked="{Binding SingleRecordIsChecked}"
							 Content="{loc:Tr ColorbarView_ANALYSIS}" />
					<RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
							 Grid.Column="4"
                                 Width="150"
                                 HorizontalAlignment="Center"
							 IsChecked="{Binding OverlayIsChecked}"
							 Content="{loc:Tr ColorbarView_OVERLAY}" />
					<RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
							 Grid.Column="5"
                                 Width="150"
                                 HorizontalAlignment="Center"
							 IsChecked="{Binding RecordComparisonIsChecked}"
							 Content="{loc:Tr ColorbarView_COMPARISON}" />
					<RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
							 Grid.Column="6"
                                 Width="150"
                                 HorizontalAlignment="Center"
							 IsChecked="{Binding AggregationIsChecked}"
							 Content="{loc:Tr ColorbarView_AGGREGATION}" />
					<RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
                             Grid.Column="7"
                                 Width="150"
                                 HorizontalAlignment="Center"
                             IsChecked="{Binding SensorIsChecked}"
                             Content="{loc:Tr ColorbarView_SENSOR}" />
					<RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
							 Grid.Column="8"
                                 Width="150"
                                 HorizontalAlignment="Center"
							 IsChecked="{Binding PmdIsChecked}"
							 Content="{loc:Tr ColorbarView_PMD}" />
					<RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
							 Grid.Column="9"
                                 Width="150"
                                 HorizontalAlignment="Center"
							 IsChecked="{Binding ReportIsChecked}"
							 Content="{loc:Tr ColorbarView_REPORT}" />
					<RadioButton Style="{StaticResource MaterialDesignTabRadioButton}"
                             Grid.Column="11"
                                 Width="150"
                                 HorizontalAlignment="Center"
                             IsChecked="{Binding CloudIsChecked}"
                             Content="{loc:Tr ColorbarView_CLOUD}" />
				</Grid>

				<materialDesign:PopupBox Grid.Column="1" Margin="0 0 225 0" DataContext="{Binding Path=DataContext, ElementName=ColorbarViewName}"
					RequestBringIntoView="PopupBox_RequestBringIntoView" StaysOpen="False"
					PlacementMode="BottomAndAlignRightEdges" HorizontalAlignment="Right" x:Name="ScreenshotPopupBox">
					<materialDesign:PopupBox.ToggleContent>
						<Button Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
						        VerticalAlignment="Center"
						        HorizontalAlignment="Right"
						        ToolTip="{loc:Tr ColorbarView_TakeAScreenshot}"
						        materialDesign:RippleAssist.Feedback="#DD000000"
                                Background="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}"
                                BorderBrush="Transparent"
						        Width="32" Height="32" Click="ScreenshotPopupBox_Open">
							<materialDesign:PackIcon Kind="PhotoLibrary" Foreground="White"/>
						</Button>
					</materialDesign:PopupBox.ToggleContent>
					<UniformGrid Columns="2" Width="180" Height="50">
						<Button Width="70" Height="40" VerticalContentAlignment="Center"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}" Foreground="White"
                                BorderBrush="Transparent"
                                HorizontalContentAlignment="Center" Padding="0"
                                Content="{loc:Tr ColorbarView_Save}" Click="SaveScreenShotButton_Click"/>
						<Button Width="70" Height="40" VerticalContentAlignment="Center"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}" Foreground="White" 
                                BorderBrush="Transparent"
                                HorizontalContentAlignment="Center" Padding="0"
                                Content="{loc:Tr ColorbarView_Copy}" Click="CopyScreenShotButton_Click"/>
					</UniformGrid>
				</materialDesign:PopupBox>

				<Button Grid.Column="1" Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            Margin="0 0 187 0"
						    ToolTip="{loc:Tr ColorbarView_Login}"
                            HorizontalAlignment="Right"
						    materialDesign:RippleAssist.Feedback="#DD000000"
						    Width="32" Height="32" Click="Login_Click"
                            Background="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}" BorderBrush="Transparent"
							Visibility="{Binding Path=DataContext.IsLoggedIn, ElementName=ColorbarViewName, Converter={StaticResource FalseToVisibleConverter}}">
					<materialDesign:PackIcon Kind="Login" Foreground="GreenYellow"/>
				</Button>

				<Button Grid.Column="1" Style="{StaticResource MaterialDesignFloatingActionMiniButton}"
                            Margin="0 0 190 0"
						    ToolTip="{loc:Tr ColorbarView_Logout}"
                            HorizontalAlignment="Right"
						    materialDesign:RippleAssist.Feedback="#DD000000"
						    Width="32" Height="32" Click="Logout_Click"
                            Background="{DynamicResource MaterialDesign.Brush.ToolBar.Item.Background}" BorderBrush="Transparent"
							Visibility="{Binding Path=DataContext.IsLoggedIn, ElementName=ColorbarViewName, Converter={StaticResource TrueToVisibleConverter}}">
					<materialDesign:PackIcon Kind="Logout" Foreground="DarkRed"/>
				</Button>

				<TextBlock Grid.Column="1" Margin="0 0 60 2" HorizontalAlignment="Right" VerticalAlignment="Center">           
			        <Hyperlink NavigateUri="https://capframex.com/" RequestNavigate="Hyperlink_RequestNavigate" TextDecorations="None">
				        <TextBlock FontSize="16" Text="{loc:Tr ColorbarView_CapFrameXCom}" Foreground="White"/>
			        </Hyperlink>	
		        </TextBlock>

				<materialDesign:PopupBox Grid.Column="1" DataContext="{Binding Path=DataContext, ElementName=ColorbarViewName}"
					materialDesign:Closed="PopupBox_Closed" RequestBringIntoView="PopupBox_RequestBringIntoView"
					Margin="16,0,16,0" Padding="0" PopupUniformCornerRadius="10"
					StaysOpen="True" PlacementMode="BottomAndAlignRightEdges" HorizontalAlignment="Right" Opened="PopupBoxOpened"
					x:Name="OptionsPopupBox">
					<materialDesign:PopupBox.ToggleContent>
						<materialDesign:PackIcon Kind="Cog" Width="30" Height="30" Foreground="White"/>
					</materialDesign:PopupBox.ToggleContent>
					<Border Width="960" Height="672"
							Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
							CornerRadius="10" SnapsToDevicePixels="True">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="184"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>

							<Border Grid.Column="0" Padding="14"
									Background="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"
									CornerRadius="10 0 0 10">
								<Grid>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="Auto"/>
									</Grid.RowDefinitions>
									<StackPanel Margin="4 4 4 22">
										<StackPanel Orientation="Horizontal">
											<materialDesign:PackIcon Kind="Cog" Width="22" Height="22"
																 VerticalAlignment="Center"
																 Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
											<TextBlock Margin="9 0 0 0" FontSize="18" FontWeight="SemiBold"
													   VerticalAlignment="Center" Text="{loc:Tr ColorbarView_Settings}"/>
										</StackPanel>
										<TextBlock Margin="0 6 0 0" FontSize="11" TextWrapping="Wrap"
												   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
												   Text="{loc:Tr ColorbarView_ConfigureCapFrameXToMatchYour}"/>
									</StackPanel>

									<StackPanel Grid.Row="1">
										<RadioButton GroupName="SettingsView" Style="{StaticResource SettingsNavigationButton}"
													 IsChecked="{Binding OptionsViewSelected}">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon Kind="Tune" Width="19" Height="19" VerticalAlignment="Center"/>
												<TextBlock Margin="11 0 0 0" VerticalAlignment="Center" Text="{loc:Tr ColorbarView_Options}"/>
											</StackPanel>
										</RadioButton>
										<RadioButton GroupName="SettingsView" Style="{StaticResource SettingsNavigationButton}"
													 IsChecked="{Binding HardwareViewSelected}">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon Kind="Gpu" Width="19" Height="19" VerticalAlignment="Center"/>
												<TextBlock Margin="11 0 0 0" VerticalAlignment="Center" Text="{loc:Tr ColorbarView_Hardware}"/>
											</StackPanel>
										</RadioButton>
										<RadioButton GroupName="SettingsView" Style="{StaticResource SettingsNavigationButton}"
													 IsChecked="{Binding AppViewSelected}">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon Kind="ApplicationOutline" Width="19" Height="19" VerticalAlignment="Center"/>
												<TextBlock Margin="11 0 0 0" VerticalAlignment="Center" Text="{loc:Tr ColorbarView_Application}"/>
											</StackPanel>
										</RadioButton>
										<RadioButton GroupName="SettingsView" Style="{StaticResource SettingsNavigationButton}"
													 IsChecked="{Binding RemoteViewSelected}">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon Kind="CloudUploadOutline" Width="19" Height="19" VerticalAlignment="Center"/>
												<TextBlock Margin="11 0 0 0" VerticalAlignment="Center" Text="{loc:Tr ColorbarView_Remote}"/>
											</StackPanel>
										</RadioButton>
										<RadioButton GroupName="SettingsView" Style="{StaticResource SettingsNavigationButton}"
													 IsChecked="{Binding UpdateViewSelected}">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon Kind="Update" Width="19" Height="19" VerticalAlignment="Center"/>
												<TextBlock Margin="11 0 0 0" VerticalAlignment="Center" Text="{loc:Tr ColorbarView_Update}"/>
											</StackPanel>
										</RadioButton>
										<RadioButton GroupName="SettingsView" Style="{StaticResource SettingsNavigationButton}"
													 IsChecked="{Binding HelpViewSelected}">
											<StackPanel Orientation="Horizontal">
												<materialDesign:PackIcon Kind="Information" Width="19" Height="19" VerticalAlignment="Center"/>
												<TextBlock Margin="11 0 0 0" VerticalAlignment="Center" Text="{loc:Tr ColorbarView_Help}"/>
											</StackPanel>
										</RadioButton>
									</StackPanel>

									<TextBlock Grid.Row="2" Margin="4 0 4 4" FontSize="10" TextWrapping="Wrap"
											   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
											   Text="{loc:Tr ColorbarView_SettingsMarkedInTheirDescription}"/>
								</Grid>
							</Border>

							<ContentPresenter Grid.Column="1" x:Name="ContentPresenterSwitchView" Content="{Binding}">
							<ContentPresenter.Resources>
								<DataTemplate x:Name="OptionsDataTemplate" x:Key="OptionsContent">
									<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
										<StackPanel Margin="24 20 18 22">
											<TextBlock Style="{StaticResource SettingsPageTitle}" Text="{loc:Tr ColorbarView_Options2}"/>
											<TextBlock Style="{StaticResource SettingsPageDescription}"
													   Text="{loc:Tr ColorbarView_ConfigureChartsCaptureMetricsLatency}"/>

											<Border Style="{StaticResource SettingsCard}">
												<StackPanel>
													<TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Tr ColorbarView_ChartsAndExport}"/>
													<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_ControlHowFPSValuesAre}"/>
											<Separator Margin="0 12 0 10" Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="18"/>
													<ColumnDefinition Width="*"/>
													<ColumnDefinition Width="18"/>
													<ColumnDefinition Width="1.25*"/>
												</Grid.ColumnDefinitions>
												<StackPanel>
															<TextBlock Style="{StaticResource SettingsOptionTitle}" Text="{loc:Tr ColorbarView_FPSGraphFilter}"/>
															<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_AverageTimeWindowInMilliseconds}"/>
															<ComboBox Margin="0 9 0 0" Height="42" MaxDropDownHeight="140"
																	  materialDesign:HintAssist.Hint="{loc:Tr ColorbarView_TimeWindowMs}"
																	  materialDesign:HintAssist.IsFloating="True"
																	  ToolTip="{loc:Tr ColorbarView_SetsTheTimeWindowFor}"
																	  ItemsSource="{Binding Path=DataContext.AverageTimeWindows, ElementName=ColorbarViewName}">
																<ComboBox.Text>
																	<Binding Path="SelectedAverageTimeWindow" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
																</ComboBox.Text>
															</ComboBox>
														</StackPanel>
												<StackPanel Grid.Column="2">
															<TextBlock Style="{StaticResource SettingsOptionTitle}" Text="{loc:Tr ColorbarView_FPSDecimals}"/>
															<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_DisplayedDecimalPlaces}"/>
															<ComboBox Margin="0 9 0 0" Height="42" MaxDropDownHeight="140"
																	  materialDesign:HintAssist.Hint="{loc:Tr ColorbarView_DecimalPlaces}"
																	  materialDesign:HintAssist.IsFloating="True"
																	  ToolTip="{loc:Tr ColorbarView_SetsTheNumberOfDecimal}"
																	  ItemsSource="{Binding Path=DataContext.RoundingDigits, ElementName=ColorbarViewName}">
																<ComboBox.Text>
																	<Binding Path="FpsValuesRoundingDigits" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
																</ComboBox.Text>
															</ComboBox>
														</StackPanel>
												<StackPanel Grid.Column="4" ToolTip="{loc:Tr ColorbarView_SelectResolutionForGraphExport}">
													<TextBlock Style="{StaticResource SettingsOptionTitle}" Text="{loc:Tr ColorbarView_GraphExportResolution}"/>
													<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_PixelDimensionsUsedByGraph}"/>
													<Grid Margin="0 9 0 0">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="Auto"/>
															<ColumnDefinition Width="*"/>
														</Grid.ColumnDefinitions>
														<TextBox Height="42" MinWidth="92" HorizontalContentAlignment="Center"
																 Text="{Binding HorizontalGraphExportRes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
																 materialDesign:HintAssist.Hint="{loc:Tr ColorbarView_Width}"
																 Style="{DynamicResource CxFloatingHintTextBox}"
																 PreviewKeyDown="ResolutionTextBox_PreviewKeyDown" MouseLeave="TextBox_MouseLeave"
																 PreviewTextInput="NumberValidationTextBox"/>
														<TextBlock Grid.Column="1" Margin="10 0" VerticalAlignment="Center" Text="×"
																   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
														<TextBox Grid.Column="2" Height="42" MinWidth="92" HorizontalContentAlignment="Center"
																 Text="{Binding VerticalGraphExportRes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
																 materialDesign:HintAssist.Hint="{loc:Tr ColorbarView_Height}"
																 Style="{DynamicResource CxFloatingHintTextBox}"
																 PreviewKeyDown="ResolutionTextBox_PreviewKeyDown" MouseLeave="TextBox_MouseLeave"
																 PreviewTextInput="NumberValidationTextBox"/>
													</Grid>
												</StackPanel>
													</Grid>
												</StackPanel>
											</Border>

											<Border Style="{StaticResource SettingsCard}">
												<StackPanel>
													<TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Tr ColorbarView_CaptureMetrics}"/>
													<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_ChooseTheTimingDataStored}"/>
													<Separator Margin="0 12 0 4" Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
													<Grid Margin="0 8" ToolTipService.ShowDuration="25000">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="Auto"/>
														</Grid.ColumnDefinitions>
														<StackPanel>
															<TextBlock Style="{StaticResource SettingsOptionTitle}" Text="{loc:Tr ColorbarView_UseMsBetweenDisplayChangeMetrics}"/>
															<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_MoreCloselyReflectsDisplayedFrames}"/>
														</StackPanel>
														<CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBox}"
																  IsChecked="{Binding UseDisplayChangeMetrics, Mode=TwoWay}">
															<CheckBox.ToolTip>
																<ToolTip MaxWidth="400">
																	<TextBlock TextWrapping="Wrap" Text="{loc:Tr ColorbarView_UseMsBetweenDisplayChangeToCalculatePerformance}"/>
																</ToolTip>
															</CheckBox.ToolTip>
														</CheckBox>
													</Grid>
													<Separator Margin="0 4" Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
													<Grid Margin="0 8" ToolTipService.ShowDuration="25000">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="Auto"/>
														</Grid.ColumnDefinitions>
														<StackPanel>
															<TextBlock Style="{StaticResource SettingsOptionTitle}" Text="{loc:Tr ColorbarView_UsePCLatency}"/>
															<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_AddsPresentMonSMsPCLatencyColumn}"/>
														</StackPanel>
														<CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBox}"
																  IsChecked="{Binding UsePcLatency, Mode=TwoWay}">
															<CheckBox.ToolTip>
																<ToolTip MaxWidth="400">
																	<TextBlock TextWrapping="Wrap" Text="{loc:Tr ColorbarView_EnablePCLatencyTrackingVia}"/>
																</ToolTip>
															</CheckBox.ToolTip>
														</CheckBox>
													</Grid>
													<Separator Margin="0 4" Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
													<Grid Margin="0 8" ToolTipService.ShowDuration="25000">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="Auto"/>
														</Grid.ColumnDefinitions>
														<StackPanel VerticalAlignment="Center">
															<TextBlock Style="{StaticResource SettingsOptionTitle}" Text="{loc:Tr ColorbarView_PresentMonEventBuffer}"/>
															<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_SizeOfPresentMonSPresent}"/>
														</StackPanel>
