																  IsChecked="{Binding UpdateViewModel.AutoUpdateCheckActive, Mode=TwoWay}"
																  ToolTip="Check for updates every time CapFrameX starts"/>
													</Grid>
												</StackPanel>
											</Border>

											<Border Style="{StaticResource SettingsCard}" Margin="0">
