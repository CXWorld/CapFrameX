															</StackPanel>
														</Border>
														<Border Grid.Column="4" Padding="14" Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" CornerRadius="6">
															<StackPanel>
																<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_LatestBeta}"/>
																<TextBlock Margin="0 4 0 0" FontSize="18" FontWeight="SemiBold"
																		   Text="{Binding UpdateViewModel.LatestBetaVersionString, Mode=OneWay}"/>
															</StackPanel>
														</Border>
													</Grid>

													<Border Margin="0 14 0 0" Padding="14"
															Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
															CornerRadius="6">
														<StackPanel>
															<TextBlock Style="{StaticResource SettingsOptionTitle}" Text="{loc:Tr ColorbarView_UpdateStatus}"/>
															<TextBlock Margin="0 5 0 0" MinHeight="34" TextWrapping="Wrap"
																	   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
																	   Text="{Binding UpdateViewModel.StatusText, Mode=OneWay}"/>
															<ProgressBar Margin="0 10 0 0" Height="6" Minimum="0" Maximum="100"
																		 Value="{Binding UpdateViewModel.DownloadProgressPercent, Mode=OneWay}"
																		 Visibility="{Binding UpdateViewModel.IsDownloading, Converter={StaticResource FalseToCollapsedConverter}}"/>
														</StackPanel>
													</Border>

													<StackPanel Margin="0 16 0 0" Orientation="Horizontal">
														<Button Width="210" Height="36"
																Style="{StaticResource MaterialDesignRaisedButton}"
																Command="{Binding UpdateViewModel.CheckForUpdateCommand}"
																ToolTip="{loc:Tr ColorbarView_AskTheCapFrameXUpdateServer}">
															<Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="16">
																<TextBlock Text="{loc:Tr ColorbarView_CHECKFORUPDATES}"/>
															</Viewbox>
														</Button>
														<Button Width="190" Height="36" Margin="10 0 0 0"
																Style="{StaticResource MaterialDesignOutlinedButton}"
																Click="ShowUpdate_Click"
																Command="{Binding UpdateViewModel.ShowUpdateDialogCommand}"
																ToolTip="{loc:Tr ColorbarView_ShowWhatTheAvailableUpdate}">
															<Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="16">
																<TextBlock Text="{loc:Tr ColorbarView_SHOWUPDATE}"/>
															</Viewbox>
														</Button>
													</StackPanel>

													<Separator Margin="0 16 0 4" Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
													<Grid Margin="0 8 0 0">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="Auto"/>
														</Grid.ColumnDefinitions>
														<StackPanel>
															<TextBlock Style="{StaticResource SettingsOptionTitle}" Text="{loc:Tr ColorbarView_CheckOnStart}"/>
															<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_CheckForANewerCapFrameX}"/>
														</StackPanel>
														<CheckBox Grid.Column="1" Style="{StaticResource SettingsCheckBox}"
																  IsChecked="{Binding UpdateViewModel.AutoUpdateCheckActive, Mode=TwoWay}"
																  ToolTip="{loc:Tr ColorbarView_CheckForUpdatesEveryTime}"/>
													</Grid>
												</StackPanel>
											</Border>

											<Border Style="{StaticResource SettingsCard}" Margin="0">
												<StackPanel>
													<TextBlock Style="{StaticResource SettingsSectionTitle}" Text="{loc:Tr ColorbarView_VersionHistory}"/>
													<TextBlock Style="{StaticResource SettingsDescription}" TextWrapping="Wrap">
														<Run Text="{loc:Tr ColorbarView_InstallAnyPublishedReleaseFrom}"/>
														<Run FontWeight="SemiBold" Text="{Binding UpdateViewModel.MinimumRollbackVersionString, Mode=OneWay}"/>
														<Run Text="{loc:Tr ColorbarView_OnwardSelectingAnOlderVersion}"/>
													</TextBlock>

													<Grid Margin="0 16 0 0">
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="*"/>
															<ColumnDefinition Width="230"/>
															<ColumnDefinition Width="12"/>
															<ColumnDefinition Width="210"/>
														</Grid.ColumnDefinitions>
														<StackPanel VerticalAlignment="Center">
															<TextBlock Style="{StaticResource SettingsOptionTitle}" Text="{loc:Tr ColorbarView_TargetVersion}"/>
															<TextBlock Style="{StaticResource SettingsDescription}" Text="{loc:Tr ColorbarView_PackagesAreVerifiedBeforeInstallation}"/>
														</StackPanel>
														<ComboBox Grid.Column="1" Height="42" MaxDropDownHeight="260"
																  ItemsSource="{Binding UpdateViewModel.AvailableVersionsView, Mode=OneWay}"
																  SelectedItem="{Binding UpdateViewModel.SelectedVersion, Mode=TwoWay}"
																  materialDesign:HintAssist.Hint="{loc:Tr ColorbarView_PublishedVersion}"
																  materialDesign:HintAssist.IsFloating="True">
															<ComboBox.GroupStyle>
																<GroupStyle>
																	<GroupStyle.HeaderTemplate>
																		<DataTemplate>
																			<TextBlock Margin="8 8 8 4" FontSize="11" FontWeight="SemiBold"
																					   Opacity="0.72" Text="{Binding Name}"/>
																		</DataTemplate>
																	</GroupStyle.HeaderTemplate>
																</GroupStyle>
															</ComboBox.GroupStyle>
															<ComboBox.ItemTemplate>
																<DataTemplate>
																	<TextBlock Margin="8 3" FontWeight="SemiBold" Text="{Binding Version}"/>
																</DataTemplate>
															</ComboBox.ItemTemplate>
														</ComboBox>
														<Button Grid.Column="3" Height="38"
																Style="{StaticResource MaterialDesignRaisedButton}"
																Command="{Binding UpdateViewModel.InstallSelectedVersionCommand}">
															<Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="16">
																<TextBlock Text="{Binding UpdateViewModel.VersionSelectionActionText, Mode=OneWay}"/>
															</Viewbox>
														</Button>
													</Grid>

													<Border Margin="0 14 0 0" Padding="12"
															Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
															CornerRadius="6"
															Visibility="{Binding UpdateViewModel.IsSelectedVersionRollback, Converter={StaticResource FalseToCollapsedConverter}}">
														<StackPanel Orientation="Horizontal">
															<materialDesign:PackIcon Kind="BackupRestore" Width="20" Height="20" Margin="0 1 10 0"
																				 VerticalAlignment="Top" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
															<TextBlock TextWrapping="Wrap" MaxWidth="590"
																	   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
																	   Text="{loc:Tr ColorbarView_RollbackReplacesTheApplicationVersion}"/>
														</StackPanel>
													</Border>
												</StackPanel>
											</Border>
										</StackPanel>
									</ScrollViewer>
								</DataTemplate>
								<DataTemplate x:Key="HelpContent">
									<Grid Margin="24 20 18 22">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="*"/>
										</Grid.RowDefinitions>
										<TextBlock Style="{StaticResource SettingsPageTitle}" Text="{loc:Tr ColorbarView_Help2}"/>
										<TextBlock Grid.Row="1" Style="{StaticResource SettingsPageDescription}"
												   Text="{loc:Tr ColorbarView_QuickReferenceForWorkingWith}"/>
										<Border Grid.Row="2" Style="{StaticResource SettingsCard}" Margin="0">
											<xctk:RichTextBox IsHitTestVisible="False" IsReadOnly="True" BorderThickness="0"
														  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
														  Background="Transparent"
														  Text="{Binding Path=DataContext.HelpText, ElementName=ColorbarViewName, Mode=OneWay}"/>
										</Border>
									</Grid>
								</DataTemplate>
							</ContentPresenter.Resources>
							<ContentPresenter.Style>
								<Style TargetType="{x:Type ContentPresenter}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="Options">
											<Setter Property="ContentTemplate" Value="{StaticResource OptionsContent}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="Hardware">
											<Setter Property="ContentTemplate" Value="{StaticResource HardwareContent}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="App">
											<Setter Property="ContentTemplate" Value="{StaticResource AppContent}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="Remote">
											<Setter Property="ContentTemplate" Value="{StaticResource RemoteContent}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="Update">
											<Setter Property="ContentTemplate" Value="{StaticResource UpdateContent}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="Help">
											<Setter Property="ContentTemplate" Value="{StaticResource HelpContent}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ContentPresenter.Style>
							</ContentPresenter>
						</Grid>
					</Border>
				</materialDesign:PopupBox>
			</Grid>
		</materialDesign:ColorZone>
	</Grid>
</UserControl>
