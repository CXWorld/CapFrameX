														</StackPanel>
														<ComboBox Grid.Column="1" Height="42" MaxDropDownHeight="260"
																  ItemsSource="{Binding UpdateViewModel.AvailableVersionsView, Mode=OneWay}"
																  SelectedItem="{Binding UpdateViewModel.SelectedVersion, Mode=TwoWay}"
																  materialDesign:HintAssist.Hint="Published version"
																  materialDesign:HintAssist.IsFloating="True">
															<ComboBox.GroupStyle>
																<GroupStyle>
																	<GroupStyle.HeaderTemplate>
																		<DataTemplate>
																			<TextBlock Margin="8 8 8 4" FontSize="11" FontWeight="SemiBold"
																					   Opacity="0.72" Text="{Binding Name}"/>
																		</DataTemplate>
																	</GroupStyle.HeaderTemplate>
																</GroupStyle>
															</ComboBox.GroupStyle>
															<ComboBox.ItemTemplate>
																<DataTemplate>
																	<TextBlock Margin="8 3" FontWeight="SemiBold" Text="{Binding Version}"/>
																</DataTemplate>
															</ComboBox.ItemTemplate>
														</ComboBox>
														<Button Grid.Column="3" Height="38"
																Style="{StaticResource MaterialDesignRaisedButton}"
																Content="{Binding UpdateViewModel.VersionSelectionActionText, Mode=OneWay}"
																Command="{Binding UpdateViewModel.InstallSelectedVersionCommand}"/>
													</Grid>

													<Border Margin="0 14 0 0" Padding="12"
															Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
															CornerRadius="6"
															Visibility="{Binding UpdateViewModel.IsSelectedVersionRollback, Converter={StaticResource FalseToCollapsedConverter}}">
														<StackPanel Orientation="Horizontal">
															<materialDesign:PackIcon Kind="BackupRestore" Width="20" Height="20" Margin="0 1 10 0"
																				 VerticalAlignment="Top" Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
															<TextBlock TextWrapping="Wrap" MaxWidth="590"
																	   Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
																	   Text="Rollback replaces the application version. Captures and settings remain, but newer settings may not be compatible with the selected release."/>
														</StackPanel>
													</Border>
												</StackPanel>
											</Border>
										</StackPanel>
									</ScrollViewer>
								</DataTemplate>
								<DataTemplate x:Key="HelpContent">
									<Grid Margin="24 20 18 22">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="Auto"/>
											<RowDefinition Height="*"/>
										</Grid.RowDefinitions>
										<TextBlock Style="{StaticResource SettingsPageTitle}" Text="Help"/>
										<TextBlock Grid.Row="1" Style="{StaticResource SettingsPageDescription}"
												   Text="Quick reference for working with CapFrameX."/>
										<Border Grid.Row="2" Style="{StaticResource SettingsCard}" Margin="0">
											<xctk:RichTextBox IsHitTestVisible="False" IsReadOnly="True" BorderThickness="0"
														  Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
														  Background="Transparent"
														  Text="{Binding Path=DataContext.HelpText, ElementName=ColorbarViewName, Mode=OneWay}"/>
										</Border>
									</Grid>
								</DataTemplate>
							</ContentPresenter.Resources>
							<ContentPresenter.Style>
								<Style TargetType="{x:Type ContentPresenter}">
									<Style.Triggers>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="Options">
											<Setter Property="ContentTemplate" Value="{StaticResource OptionsContent}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="Hardware">
											<Setter Property="ContentTemplate" Value="{StaticResource HardwareContent}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="App">
											<Setter Property="ContentTemplate" Value="{StaticResource AppContent}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="Remote">
											<Setter Property="ContentTemplate" Value="{StaticResource RemoteContent}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="Update">
											<Setter Property="ContentTemplate" Value="{StaticResource UpdateContent}" />
										</DataTrigger>
										<DataTrigger Binding="{Binding DataContext.SelectedView, ElementName=ColorbarViewName}" Value="Help">
											<Setter Property="ContentTemplate" Value="{StaticResource HelpContent}" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ContentPresenter.Style>
							</ContentPresenter>
						</Grid>
					</Border>
				</materialDesign:PopupBox>
			</Grid>
		</materialDesign:ColorZone>
	</Grid>
</UserControl>
