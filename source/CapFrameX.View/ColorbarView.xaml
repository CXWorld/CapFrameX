																	 materialDesign:HintAssist.Hint="OSD WebSocket URL"
																	 Style="{DynamicResource CxFloatingHintTextBox}"
																	 ToolTip="WebSocket URL to access the current overlay output (overlay needs to be active)"/>
															<TextBox Height="42" Text="{Binding SensorsWSUrl, Mode=OneWay}" IsReadOnly="True"
