<UserControl x:Class="CapFrameX.View.InfoView"
             Name="InfoViewUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mvvm="clr-namespace:CapFrameX.MVVM.Converter;assembly=CapFrameX.MVVM"
             xmlns:prism="http://prismlibrary.com/"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/CxCards.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <mvvm:NullToVisibilityConverter x:Key="NullToVisibleConverter" NullValue="Visible" NotNullValue="Collapsed"/>

            <!--Small all-caps caption above a hardware name-->
            <Style x:Key="CardCaption" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
            </Style>
            <Style x:Key="HardwareName" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="HardwareDetail" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>
            <Style x:Key="MetricLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="MetricValue" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <Setter Property="Margin" Value="0 4 0 0"/>
            </Style>
            <Style x:Key="MetricIcon" TargetType="{x:Type materialDesign:PackIcon}">
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0 0 5 0"/>
            </Style>
            <Style x:Key="LoadValue" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="FontWeight" Value="Light"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            </Style>
            <!--Slim rounded progress bar; own template so it does not depend on the
                MDIX ProgressBar style keys-->
            <Style x:Key="LoadBar" TargetType="{x:Type ProgressBar}">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Minimum" Value="0"/>
                <Setter Property="Maximum" Value="100"/>
                <Setter Property="Margin" Value="0 7 0 0"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}"/>
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ProgressBar}">
                            <Grid>
                                <Border CornerRadius="3" Background="{TemplateBinding Background}"/>
                                <Border x:Name="PART_Track" Opacity="0"/>
                                <Border x:Name="PART_Indicator" CornerRadius="3" HorizontalAlignment="Left"
                                        Background="{TemplateBinding Foreground}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="MetricTile" TargetType="{x:Type Border}" BasedOn="{StaticResource SectionCardInset}">
                <Setter Property="Padding" Value="11 8"/>
                <Setter Property="Margin" Value="0 0 8 0"/>
            </Style>
            <Style x:Key="StatusRow" TargetType="{x:Type Border}" BasedOn="{StaticResource SectionCardInset}">
                <Setter Property="Padding" Value="12 9"/>
                <Setter Property="Margin" Value="0 0 0 8"/>
            </Style>

            <!--Vendor wordmark chip, colors provided by the VendorBadge model-->
            <DataTemplate x:Key="VendorBadgeTemplate">
                <Border CornerRadius="6" Height="38" MinWidth="74" Padding="13 0"
                        Background="{Binding Background}"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}"
                               Foreground="{Binding Foreground}"
                               FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="1150" Margin="15 12 15 15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--System header: OS info-->
            <Border Grid.Row="0" Style="{StaticResource SectionCard}" Margin="5" Padding="20 12">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="MicrosoftWindows" Width="30" Height="30"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
                    <StackPanel Margin="15 0 0 0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardCaption}" Text="OPERATING SYSTEM"/>
                        <TextBlock Style="{StaticResource HardwareName}" FontSize="14" Margin="0 2 0 0" Text="{Binding OsVersion}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <UniformGrid Grid.Row="1" Columns="2">

                <!--CPU-->
                <Border Style="{StaticResource SectionCard}" Margin="5" Padding="20 16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*" MinHeight="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <ContentControl Content="{Binding CpuVendorBadge}" ContentTemplate="{StaticResource VendorBadgeTemplate}"/>
                                <Border Style="{StaticResource SectionCardInset}" Width="74" Height="38"
                                        Visibility="{Binding CpuVendorBadge, Converter={StaticResource NullToVisibleConverter}}">
                                    <materialDesign:PackIcon Kind="Chip" Width="22" Height="22"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardCaption}" Text="PROCESSOR"/>
                                <TextBlock Style="{StaticResource HardwareName}" Margin="0 2 0 0"
                                           Text="{Binding CpuName}" ToolTip="{Binding CpuName}"/>
                                <TextBlock Style="{StaticResource HardwareDetail}" Margin="0 2 0 0" Text="{Binding CpuDetails}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid>
                                <TextBlock Style="{StaticResource MetricLabel}" FontSize="11" VerticalAlignment="Bottom" Text="Load"/>
                                <TextBlock Style="{StaticResource LoadValue}" HorizontalAlignment="Right" Text="{Binding CpuLoadText}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource LoadBar}" Value="{Binding CpuLoad, Mode=OneWay}"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="4" Columns="3">
                            <Border Style="{StaticResource MetricTile}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Style="{StaticResource MetricIcon}" Kind="Flash"/>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="Power"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CpuPowerText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTile}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Style="{StaticResource MetricIcon}" Kind="Thermometer"/>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="Temperature"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CpuTempText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTile}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Style="{StaticResource MetricIcon}" Kind="Speedometer"/>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="Clock"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding CpuClockText}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!--GPU-->
                <Border Style="{StaticResource SectionCard}" Margin="5" Padding="20 16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*" MinHeight="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <ContentControl Content="{Binding GpuVendorBadge}" ContentTemplate="{StaticResource VendorBadgeTemplate}"/>
                                <Border Style="{StaticResource SectionCardInset}" Width="74" Height="38"
                                        Visibility="{Binding GpuVendorBadge, Converter={StaticResource NullToVisibleConverter}}">
                                    <materialDesign:PackIcon Kind="ExpansionCardVariant" Width="22" Height="22"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardCaption}" Text="GRAPHICS CARD"/>
                                <TextBlock Style="{StaticResource HardwareName}" Margin="0 2 0 0"
                                           Text="{Binding GpuName}" ToolTip="{Binding GpuName}"/>
                                <TextBlock Style="{StaticResource HardwareDetail}" Margin="0 2 0 0" Text="{Binding GpuDetails}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid>
                                <TextBlock Style="{StaticResource MetricLabel}" FontSize="11" VerticalAlignment="Bottom" Text="Load"/>
                                <TextBlock Style="{StaticResource LoadValue}" HorizontalAlignment="Right" Text="{Binding GpuLoadText}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource LoadBar}" Value="{Binding GpuLoad, Mode=OneWay}"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="4" Columns="4">
                            <Border Style="{StaticResource MetricTile}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Style="{StaticResource MetricIcon}" Kind="Flash"/>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="Power"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding GpuPowerText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTile}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Style="{StaticResource MetricIcon}" Kind="Thermometer"/>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="Temperature"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding GpuTempText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTile}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Style="{StaticResource MetricIcon}" Kind="Speedometer"/>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="Clock"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding GpuClockText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTile}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Style="{StaticResource MetricIcon}" Kind="Memory"/>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="VRAM"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding GpuVramText}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>

                <!--Mainboard-->
                <Border Style="{StaticResource SectionCard}" Margin="5" Padding="20 16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*" MinHeight="18"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <ContentControl Content="{Binding MainboardVendorBadge}" ContentTemplate="{StaticResource VendorBadgeTemplate}"/>
                                <Border Style="{StaticResource SectionCardInset}" Width="74" Height="38"
                                        Visibility="{Binding MainboardVendorBadge, Converter={StaticResource NullToVisibleConverter}}">
                                    <materialDesign:PackIcon Kind="DeveloperBoard" Width="22" Height="22"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardCaption}" Text="MAINBOARD"/>
                                <TextBlock Style="{StaticResource HardwareName}" Margin="0 2 0 0"
                                           Text="{Binding MainboardName}" ToolTip="{Binding MainboardName}"/>
                                <TextBlock Style="{StaticResource HardwareDetail}" Margin="0 2 0 0" Text="{Binding MainboardDetails}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <Border Style="{StaticResource StatusRow}">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Right" Width="10" Height="10" VerticalAlignment="Center"
                                             Fill="{Binding ResizableBarStatusColor}"/>
                                    <TextBlock Style="{StaticResource MetricLabel}" FontSize="12" Text="Resizable BAR"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource StatusRow}">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Right" Width="10" Height="10" VerticalAlignment="Center"
                                             Fill="{Binding HagsStatusColor}"/>
                                    <TextBlock Style="{StaticResource MetricLabel}" FontSize="12" Text="Hardware-accelerated GPU scheduling"/>
                                </DockPanel>
                            </Border>
                            <Border Style="{StaticResource StatusRow}" Margin="0">
                                <DockPanel>
                                    <Ellipse DockPanel.Dock="Right" Width="10" Height="10" VerticalAlignment="Center"
                                             Fill="{Binding GameModeStatusColor}"/>
                                    <TextBlock Style="{StaticResource MetricLabel}" FontSize="12" Text="Windows Game Mode"/>
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--Memory-->
                <Border Style="{StaticResource SectionCard}" Margin="5" Padding="20 16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1*" MinHeight="18"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <ContentControl Content="{Binding RamVendorBadge}" ContentTemplate="{StaticResource VendorBadgeTemplate}"/>
                                <Border Style="{StaticResource SectionCardInset}" Width="74" Height="38"
                                        Visibility="{Binding RamVendorBadge, Converter={StaticResource NullToVisibleConverter}}">
                                    <materialDesign:PackIcon Kind="Memory" Width="22" Height="22"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardCaption}" Text="MEMORY"/>
                                <TextBlock Style="{StaticResource HardwareName}" Margin="0 2 0 0"
                                           Text="{Binding RamName}" ToolTip="{Binding RamName}"/>
                                <TextBlock Style="{StaticResource HardwareDetail}" Margin="0 2 0 0" Text="{Binding RamDetails}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid>
                                <TextBlock Style="{StaticResource MetricLabel}" FontSize="11" VerticalAlignment="Bottom" Text="Usage"/>
                                <TextBlock Style="{StaticResource LoadValue}" HorizontalAlignment="Right" Text="{Binding RamLoadText}"/>
                            </Grid>
                            <ProgressBar Style="{StaticResource LoadBar}" Value="{Binding RamLoad, Mode=OneWay}"/>
                        </StackPanel>

                        <UniformGrid Grid.Row="4" Columns="2">
                            <Border Style="{StaticResource MetricTile}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Style="{StaticResource MetricIcon}" Kind="TrayArrowDown"/>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="In use"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding RamUsedText}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource MetricTile}" Margin="0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Style="{StaticResource MetricIcon}" Kind="PackageVariantClosed"/>
                                        <TextBlock Style="{StaticResource MetricLabel}" Text="Available"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource MetricValue}" Text="{Binding RamAvailableText}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Border>
            </UniformGrid>
        </Grid>
    </ScrollViewer>
</UserControl>
