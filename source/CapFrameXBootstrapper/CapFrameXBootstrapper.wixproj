<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>CapFrameXBootstrapper</OutputName>
    <OutputType>Bundle</OutputType>
    <ProjectGuid>{9e2fab6f-117c-495a-a47b-52a15b9e9806}</ProjectGuid>
    <Platforms>x64</Platforms>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <!-- WiX v4+ builds a bundle for the project platform, WiX v3 bundles were always 32-bit.
         Staying on x86 keeps the Burn engine, its registration and its registry searches in
         the views the v3 bundles used; the chained MSI is x64 either way. -->
    <InstallerPlatform>x86</InstallerPlatform>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>
  <Import Project="..\..\version\Version.props" />
  <PropertyGroup>
    <DefineConstants Condition=" '$(Configuration)' == 'Debug' ">$(DefineConstants);Debug</DefineConstants>
    <DefineConstants>$(DefineConstants);CapFrameXVersion=$(CapFrameXVersion)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
    <PackageReference Include="WixToolset.Bal.wixext" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CapFrameXInstaller\CapFrameXInstaller.wixproj" />
    <!-- BAFunctions DLL that lets this bundle replace a newer CapFrameX bundle (see Bundle.wxs).
         The BA runs in the 32-bit bundle, so the DLL is always built for Win32. -->
    <ProjectReference Include="..\CapFrameXBootstrapper.BAFunctions\CapFrameXBootstrapper.BAFunctions.vcxproj" Properties="Platform=Win32" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
