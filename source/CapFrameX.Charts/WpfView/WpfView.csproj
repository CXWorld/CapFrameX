<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>LiveCharts.Wpf</RootNamespace>
    <AssemblyName>LiveCharts.Wpf</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <!-- Vendored LiveCharts: the library calls its own [Obsolete] members internally (ChartFunctions
         .GetUnitWidth, AxisSection.UpdateSection, Axis.AxisChanged, Chart.PrepareScrolBar, ...).
         Resolving these means changing upstream code, so the obsolete diagnostics are silenced
         here rather than in every consumer. -->
    <NoWarn>$(NoWarn);CS0612;CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CapFrameX.Extensions\CapFrameX.Extensions.csproj" />
    <ProjectReference Include="..\Core40\Core.csproj" />
  </ItemGroup>

</Project>
