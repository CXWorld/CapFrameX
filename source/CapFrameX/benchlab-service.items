<Project>
  <ItemGroup>
    <Content Include="..\..\benchlab-service\appsettings.json">
      <Link>benchlab-service\appsettings.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\benchlab-service\BL_Service.exe">
      <Link>benchlab-service\BL_Service.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\benchlab-service\LICENSE-BENCHLAB-Service.txt">
      <Link>benchlab-service\LICENSE-BENCHLAB-Service.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\benchlab-service\VERSION">
      <Link>benchlab-service\VERSION</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
