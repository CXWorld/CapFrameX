<Application x:Class="CapFrameX.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
			 Exit="ApplicationExit" Startup="ApplicationStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:CustomColorTheme BaseTheme="Inherit" PrimaryColor="#0271F9" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/CapFrameX.View;component/Styles/CxTextFields.xaml" />
                <ResourceDictionary Source="Themes/CxScrollBar.xaml" />
                <ResourceDictionary Source="Themes/CxToggleButton.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="Cx.Brush.OutlinedAction.Foreground" Color="#0271F9" />
            <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource CxCompactSwitchToggleButton}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
