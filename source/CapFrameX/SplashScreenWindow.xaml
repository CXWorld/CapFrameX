<Window x:Class="CapFrameX.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CapFrameX"
        Width="440" Height="300"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Opacity="0">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- Fade-in -->
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25" />

                    <!-- Indeterminate progress runner; 336 = inner content width -->
                    <DoubleAnimation Storyboard.TargetName="RunnerTransform"
                                     Storyboard.TargetProperty="X"
                                     From="-110" To="336" Duration="0:0:1.3"
                                     RepeatBehavior="Forever" />

                    <!-- Subtle logo glow pulse -->
                    <DoubleAnimation Storyboard.TargetName="LogoIcon"
                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                     From="0.25" To="0.6" Duration="0:0:1.2"
                                     AutoReverse="True" RepeatBehavior="Forever" />
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border Margin="20"
            CornerRadius="14"
            BorderThickness="1"
            BorderBrush="#2A2D36">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FF17181D" Offset="0" />
                <GradientStop Color="#FF1B1D24" Offset="1" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid Margin="32,30,32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Brand block -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="LogoIcon"
                       Source="pack://application:,,,/Icons/CX_Concepts/Production/cx_icon_BUC_256_preview.png"
                       Width="64" Height="64"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect Color="#0271F9" BlurRadius="26" ShadowDepth="0" Opacity="0.25" />
                    </Image.Effect>
                </Image>
                <Image Source="pack://application:,,,/Icons/CX_Screen_Logo_Name.png"
                       Height="20" Margin="0,18,0,0"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </StackPanel>

            <!-- Status row -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBlock x:Name="StatusText"
                           Text="Starting..."
                           Foreground="#8A8F9C" FontSize="12"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText"
                               Foreground="#8A8F9C" FontSize="12" />
                    <Border x:Name="ChannelBadge"
                            Visibility="Collapsed"
                            Background="#14345E" CornerRadius="4"
                            Padding="5,1,5,2" Margin="8,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="ChannelText"
                                   Foreground="#6FB1FF" FontSize="10" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Indeterminate progress bar -->
            <Border Grid.Row="2" Height="4" CornerRadius="2" Background="#262A33" ClipToBounds="True">
                <Rectangle Width="110" Height="4"
                           HorizontalAlignment="Left"
                           RadiusX="2" RadiusY="2">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#000271F9" Offset="0" />
                            <GradientStop Color="#FF0271F9" Offset="0.55" />
                            <GradientStop Color="#FF35C2FF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="RunnerTransform" X="-110" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
        </Grid>
    </Border>
</Window>
