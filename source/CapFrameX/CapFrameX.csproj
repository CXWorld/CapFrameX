<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <RootNamespace>CapFrameX</RootNamespace>
    <AssemblyName>CapFrameX</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Icons\cx_icon_BUC.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Icons\CapFrameXLogoOnly.png" />
    <Resource Include="Icons\Empty.png" />
    <Resource Include="Icons\cx_icon_BUC.ico" />
    <Resource Include="Icons\CX_Icon.png" />
    <Resource Include="Icons\CX_Screen_Logo_Name.png" />
    <Content Include="HelpTexts\ChartControls.rtf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Files\bf0822e8-2e55-4b99-82ee-939d8ac2384e.bat">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <COMReference Include="Shell32">
      <Guid>{50A7E9B0-70EF-11D1-B75A-00A0C90564FE}</Guid>
      <VersionMajor>1</VersionMajor>
      <VersionMinor>0</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>tlbimp</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <Import Project="benchlab-service.items" Condition="Exists('benchlab-service.items')" />

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="16.1.1" />
    <PackageReference Include="ControlzEx" Version="4.4.0" />
    <PackageReference Include="Cyotek.Drawing.BitmapFont" Version="1.3.4" />
    <PackageReference Include="DryIoc.dll" Version="4.1.0" />
    <PackageReference Include="EmbedIO" Version="3.4.3" />
    <PackageReference Include="gong-wpf-dragdrop" Version="3.2.1" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Jot" Version="2.1.17" />
    <PackageReference Include="MahApps.Metro" Version="2.4.10" />
    <PackageReference Include="MaterialDesignColors" Version="5.2.1" />
    <PackageReference Include="MaterialDesignThemes" Version="5.2.1" />
    <PackageReference Include="MaterialDesignThemes.MahApps" Version="5.2.1" />
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.9" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.9" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageReference Include="Prism.Core" Version="7.2.0.1422" />
    <PackageReference Include="Prism.DryIoc" Version="7.2.0.1422" />
    <PackageReference Include="Serilog" Version="2.9.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="3.0.1" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="1.1.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="4.1.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.17.0" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CapFrameX.ApiInterface\CapFrameX.Remote.csproj" />
    <ProjectReference Include="..\CapFrameX.Mcp\CapFrameX.Mcp.csproj" />
    <ProjectReference Include="..\CapFrameX.Capture.Contracts\CapFrameX.Capture.Contracts.csproj" />
    <ProjectReference Include="..\CapFrameX.Configuration\CapFrameX.Configuration.csproj" />
    <ProjectReference Include="..\CapFrameX.Contracts\CapFrameX.Contracts.csproj" />
    <ProjectReference Include="..\CapFrameX.Data\CapFrameX.Data.csproj" />
    <ProjectReference Include="..\CapFrameX.EventAggregation\CapFrameX.EventAggregation.csproj" />
    <ProjectReference Include="..\CapFrameX.Extensions\CapFrameX.Extensions.csproj" />
    <ProjectReference Include="..\CapFrameX.Hardware.Controller\CapFrameX.Hardware.Controller.csproj" />
    <ProjectReference Include="..\CapFrameX.Hotkey\CapFrameX.Hotkey.csproj" />
    <ProjectReference Include="..\CapFrameX.Monitoring.Contracts\CapFrameX.Monitoring.Contracts.csproj" />
    <ProjectReference Include="..\CapFrameX.MVVM\CapFrameX.MVVM.csproj" />
    <ProjectReference Include="..\CapFrameX.Overlay\CapFrameX.Overlay.csproj" />
    <ProjectReference Include="..\CapFrameX.PMD\CapFrameX.PMD.csproj" />
    <ProjectReference Include="..\CapFrameX.PresentMonInterface\CapFrameX.PresentMonInterface.csproj" />
    <ProjectReference Include="..\CapFrameX.OSD.Integration\CapFrameX.OSD.Integration.csproj" />
    <ProjectReference Include="..\..\external\CapFrameX.OSD\CapFrameX.OSD.Interop\CapFrameX.OSD.Interop.csproj" Condition="'$(CfxOsdFromSource)' == 'true'">
      <!-- The optional submodule project is not listed in CapFrameX.sln, so Visual Studio
           cannot apply a solution platform mapping to this x64-only reference. -->
      <SetPlatform>Platform=x64</SetPlatform>
    </ProjectReference>
    <ProjectReference Include="..\CapFrameX.RTSSIntegration\CapFrameX.RTSSIntegration.csproj" />
    <ProjectReference Include="..\CapFrameX.RTSSInterface\CapFrameX.RTSSInterface.vcxproj" />
    <ProjectReference Include="..\CapFrameX.Sensor\CapFrameX.Sensor.csproj" />
    <ProjectReference Include="..\CapFrameX.Statistics.NetStandard\CapFrameX.Statistics.NetStandard.csproj" />
    <ProjectReference Include="..\CapFrameX.SystemInfo.NetStandard\CapFrameX.SystemInfo.NetStandard.csproj" />
    <ProjectReference Include="..\CapFrameX.Updater\CapFrameX.Updater.csproj" />
    <ProjectReference Include="..\CapFrameX.ViewModel\CapFrameX.ViewModel.csproj" />
    <ProjectReference Include="..\CapFrameX.View\CapFrameX.View.csproj" />
    <ProjectReference Include="..\LibreHardwareMonitorLib\LibreHardwareMonitorLib.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- CapFrameX.OSD lives in a private repo, consumed as an optional submodule under
         external\CapFrameX.OSD. With the submodule checked out the OSD is built from
         source; otherwise the prebuilt binaries in external\CapFrameX.OSD-prebuilt
         are used so the app always builds with full OSD functionality. -->
    <CfxOsdFromSource Condition="'$(CfxOsdFromSource)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\external\CapFrameX.OSD\CapFrameX.OSD.Interop\CapFrameX.OSD.Interop.csproj')">true</CfxOsdFromSource>
    <!-- Preserve the explicit x64 mapping on the optional project reference. Visual Studio
         otherwise removes the platform for projects that are not listed in the solution. -->
    <ShouldUnsetParentConfigurationAndPlatform Condition="'$(CfxOsdFromSource)' == 'true' And '$(ShouldUnsetParentConfigurationAndPlatform)' == ''">false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <ItemGroup Condition="'$(CfxOsdFromSource)' != 'true'">
    <Reference Include="CapFrameX.OSD.Interop">
      <HintPath>..\..\external\CapFrameX.OSD-prebuilt\net9.0-windows\CapFrameX.OSD.Interop.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Native renderer: staged from the submodule's CMake output when built from source
       (via the Interop project's content items); otherwise use the prebuilt DLL. -->
  <ItemGroup Condition="!Exists('$(MSBuildThisFileDirectory)..\..\external\CapFrameX.OSD\CapFrameX.OSD\build\bin\RelWithDebInfo\cfx_osd_core.dll')">
    <Content Include="..\..\external\CapFrameX.OSD-prebuilt\native\cfx_osd_core.dll">
      <Link>cfx_osd_core.dll</Link>
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- The native C++ projects are built by solution dependencies and their post-build steps
       stage the DLLs in the configuration directory ABOVE the target-framework-specific app
       output — the layout that existed before the net9.0-windows migration. Copy them next to
       CapFrameX.exe, otherwise every P/Invoke into them throws DllNotFoundException.
       That failure is silent: the sensor groups catch it and fall back, so the only symptom is
       missing hardware. Without CapFrameX.IGCL.dll an Intel Arc drops to LibreHardwareMonitor's
       integrated-GPU path (two D3D memory counters, no temperature/power/clock/load and an
       unknown driver version); without CapFrameX.ADLX.dll the same happens to AMD cards. -->
  <ItemGroup>
    <CfxNativeRuntimeDll Include="CapFrameX.Hwinfo.dll" />
    <CfxNativeRuntimeDll Include="CapFrameX.IGCL.dll" />
    <CfxNativeRuntimeDll Include="CapFrameX.ADLX.dll" />
  </ItemGroup>

  <Target Name="StageCapFrameXNativeRuntime" AfterTargets="Build" Condition="'$(Platform)' == 'x64'">
    <ItemGroup>
      <CfxNativeRuntimeSource Include="$(OutputPath)..\%(CfxNativeRuntimeDll.Identity)"
                              Condition="Exists('$(OutputPath)..\%(CfxNativeRuntimeDll.Identity)')" />
    </ItemGroup>
    <Copy SourceFiles="@(CfxNativeRuntimeSource)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
