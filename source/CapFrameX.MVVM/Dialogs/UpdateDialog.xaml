<UserControl x:Class="CapFrameX.MVVM.Dialogs.UpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CapFrameX.MVVM.Dialogs"
             xmlns:converter="clr-namespace:CapFrameX.MVVM.Converter"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converter:BoolToVisibilityConverter x:Key="FalseToCollapsedConverter" FalseValue="Collapsed" TrueValue="Visible"/>
        <converter:BoolToVisibilityConverter x:Key="TrueToCollapsedConverter" FalseValue="Visible" TrueValue="Collapsed"/>
    </UserControl.Resources>
    <Grid Width="500" MaxHeight="460" Margin="20 18 20 15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <materialDesign:PackIcon Kind="Download" Width="26" Height="26" VerticalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                     Visibility="{Binding IsRollback, Converter={StaticResource TrueToCollapsedConverter}}"/>
            <materialDesign:PackIcon Kind="BackupRestore" Width="26" Height="26" VerticalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                                     Visibility="{Binding IsRollback, Converter={StaticResource FalseToCollapsedConverter}}"/>
            <TextBlock Margin="10 0 0 0" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                       Text="{Binding UpdateDialogTitle, Mode=OneWay}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0 12 0 0" Orientation="Horizontal">
            <TextBlock Text="Target version" VerticalAlignment="Center"/>
            <TextBlock Margin="6 0 0 0" FontWeight="Bold" VerticalAlignment="Center"
                       Text="{Binding AvailableVersionString, Mode=OneWay}"/>
            <TextBlock Margin="7 0 0 0" VerticalAlignment="Center" Opacity="0.7"
                       Text="{Binding TargetChannelString, Mode=OneWay, StringFormat=({0})}"/>
            <TextBlock Margin="10 0 0 0" VerticalAlignment="Center" Opacity="0.7"
                       Visibility="{Binding HasReleaseDate, Converter={StaticResource FalseToCollapsedConverter}}"
                       Text="{Binding ReleaseDateText, Mode=OneWay, StringFormat=(released {0})}"/>
            <TextBlock Margin="10 0 0 0" VerticalAlignment="Center" Opacity="0.7"
                       Text="{Binding InstalledVersionString, Mode=OneWay, StringFormat=installed: {0}}"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="0 14 0 0" TextWrapping="Wrap" LineHeight="19"
                   Text="{Binding ReleaseSummary, Mode=OneWay}"/>

        <ScrollViewer Grid.Row="3" Margin="0 10 0 0" MaxHeight="150" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasReleaseHighlights, Converter={StaticResource FalseToCollapsedConverter}}">
            <ItemsControl ItemsSource="{Binding ReleaseHighlights, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0 3 0 3" Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChevronRight" Width="16" Height="16" Margin="0 2 6 0"
                                                     VerticalAlignment="Top" Opacity="0.7"/>
                            <TextBlock Width="410" TextWrapping="Wrap" Text="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Margin="0 14 0 0" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{Binding PackageSizeText, Mode=OneWay}"/>
            <Button Margin="14 0 0 0" Padding="4 0 4 0" Style="{DynamicResource MaterialDesignFlatButton}"
                    Visibility="{Binding HasReleaseNotesLink, Converter={StaticResource FalseToCollapsedConverter}}"
                    Command="{Binding OpenReleaseNotesCommand}" Content="RELEASE NOTES"/>
        </StackPanel>

        <!-- The download is confirmed here. Every other state - already downloading, already
             staged, or a failed check - has nothing left to confirm and only needs a way out. -->
        <StackPanel Grid.Row="5" Margin="0 18 0 0" Orientation="Horizontal" HorizontalAlignment="Right"
                    Visibility="{Binding CanConfirmUpdate, Converter={StaticResource FalseToCollapsedConverter}}">
            <TextBlock Width="280" Margin="0 0 10 0" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontSize="11" Opacity="0.7"
                       Text="{Binding InstallConfirmationText, Mode=OneWay}"/>
            <Button Width="100" Height="30" Content="{Binding ConfirmActionText, Mode=OneWay}"
                    Command="{Binding ConfirmUpdateCommand}"/>
            <Button Width="90" Height="30" Margin="10 0 0 0" Content="Cancel"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0 18 0 0" Orientation="Horizontal" HorizontalAlignment="Right"
                    Visibility="{Binding CanConfirmUpdate, Converter={StaticResource TrueToCollapsedConverter}}">
            <TextBlock Width="330" Margin="0 0 10 0" VerticalAlignment="Center" TextWrapping="Wrap"
                       FontSize="11" Opacity="0.7" Text="{Binding StatusText, Mode=OneWay}"/>
            <Button Width="90" Height="30" Content="Close"
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>
