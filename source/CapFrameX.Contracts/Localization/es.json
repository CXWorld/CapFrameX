  // Phrases: regex rules for OSD labels that have no exact "overlay" entry (sensor and group names).
  // Matched case-insensitively and applied longest pattern first; the order of patterns with the
  // same length is not guaranteed, so a specific rule must be longer than the generic one it overrides.
  // Replacements are lowercase: the first letter of the result is capitalized afterwards.
  // Spanish puts the device after the noun: "GPU Core" -> "Núcleo GPU".
  "phrases": [
    {
      "pattern": "\\bDistance to TjMax\\b",
      "replacement": "distancia a TjMax"
    },
    {
      "pattern": "^Aggregate$",
      "replacement": "agregación"
    },
    {
      "pattern": "Run (\\d+):",
      "replacement": "Pasada $1:"
    },
    {
      "pattern": "ready to capture\\.\\.\\.",
      "replacement": "listo para capturar..."
    },
    {
      "pattern": "\\bPerformance\\b",
      "replacement": "rendimiento"
    },
    {
      "pattern": "CapFrameX overlay refresh",
      "replacement": "actualización del overlay de CapFrameX"
    },
    {
      "pattern": "(\\d+)\\s*Cores\\b",
      "replacement": "$1 núcleos"
    },
    {
      "pattern": "(\\d+)\\s*Threads\\b",
      "replacement": "$1 hilos"
    },
    {
      "pattern": "\\bGPU Memory Temperature\\b",
      "replacement": "temperatura memoria GPU"
    },
    {
      "pattern": "\\bGPU Memory Dedicated Game\\b",
      "replacement": "memoria GPU dedicada del juego"
    },
    {
      "pattern": "\\bGPU Memory Shared Game\\b",
      "replacement": "memoria GPU compartida del juego"
    },
    {
      "pattern": "\\bGPU Memory Junction\\b",
      "replacement": "unión memoria GPU"
    },
    {
      "pattern": "\\bGPU Memory Bandwidth\\b",
