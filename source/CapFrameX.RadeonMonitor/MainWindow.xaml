<Window x:Class="CapFrameX.RadeonMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CapFrameX Radeon SMU Monitor"
        Width="1180"
        Height="800"
        MinWidth="920"
        MinHeight="620"
        Background="#181A1F"
        Foreground="#ECEFF4"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="88" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252932" />
            <Setter Property="Foreground" Value="#ECEFF4" />
            <Setter Property="BorderBrush" Value="#4C566A" />
            <Setter Property="CaretBrush" Value="#ECEFF4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinWidth" Value="110" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#D8DEE9" />
            <Setter Property="BorderBrush" Value="#3B4252" />
            <Setter Property="Padding" Value="10" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="Radeon SMU Monitoring Test" />
            <TextBlock Margin="0,3,0,0"
                       Foreground="#9AA3B2"
                       Text="Raw SMU metrics via PawnIO with AMD ADL PMLog fallback for RDNA3" />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="PawnIO module" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ModulePathTextBox"
                         Grid.Column="0"
                         Height="31"
                         Padding="8,5"
                         VerticalContentAlignment="Center"
                         ToolTip="Path to the bundled RadeonSMU module or a module override" />
                <Button Grid.Column="1" Content="Browse..." Click="BrowseButton_Click" />
                <Button x:Name="LoadModuleButton"
                        Grid.Column="2"
                        Margin="0"
                        Content="Load module"
                        Click="LoadModuleButton_Click" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Device and polling" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="DeviceInfoText"
                           Grid.Row="0"
                           Margin="0,0,0,10"
                           Foreground="#AEB8C8"
                           Text="No module loaded."
                           TextWrapping="Wrap" />
                <WrapPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Generation:" />
                    <ComboBox x:Name="GenerationComboBox"
                              Margin="0,0,18,0"
                              SelectionChanged="GenerationComboBox_SelectionChanged" />
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="RDNA2 layout:" />
                    <ComboBox x:Name="Rdna2LayoutComboBox" Margin="0,0,18,0" />
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="RDNA3 layout:" />
                    <ComboBox x:Name="Rdna3LayoutComboBox" Margin="0,0,18,0" />
                    <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="Interval:" />
                    <TextBox x:Name="IntervalTextBox"
                             Width="72"
                             Height="29"
                             Margin="0,0,4,0"
                             Padding="6,4"
                             Text="1000" />
                    <TextBlock Margin="0,0,18,0" VerticalAlignment="Center" Text="ms" />
                    <Button x:Name="ReadOnceButton"
                            Content="Read once"
                            IsEnabled="False"
                            Click="ReadOnceButton_Click" />
                    <Button x:Name="StartButton"
                            Content="Start"
                            IsEnabled="False"
                            Click="StartButton_Click" />
                    <Button x:Name="StopButton"
                            Margin="0"
                            Content="Stop"
                            IsEnabled="False"
                            Click="StopButton_Click" />
                </WrapPanel>
            </Grid>
        </GroupBox>

        <DataGrid x:Name="MetricsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="True"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="#20242B"
                  Foreground="#ECEFF4"
                  BorderBrush="#3B4252"
                  HorizontalGridLinesBrush="#343A46"
                  RowBackground="#20242B"
                  AlternatingRowBackground="#252A33"
                  SelectionMode="Single">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#303642" />
                    <Setter Property="Foreground" Value="#ECEFF4" />
                    <Setter Property="BorderBrush" Value="#4C566A" />
                    <Setter Property="Padding" Value="8,6" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="7,4" />
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#3B6EA8" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Width="145" Binding="{Binding Group}" Header="Group" />
                <DataGridTextColumn Width="*" MinWidth="260" Binding="{Binding Name}" Header="Metric" />
                <DataGridTextColumn Width="130" Binding="{Binding Value}" Header="Value" />
                <DataGridTextColumn Width="85" Binding="{Binding Unit}" Header="Unit" />
                <DataGridTextColumn Width="150" Binding="{Binding Raw}" Header="Raw" />
            </DataGrid.Columns>
        </DataGrid>

        <Expander x:Name="RawDumpExpander"
                  Grid.Row="4"
                  Margin="0,8,0,0"
                  Header="Raw DWORD dump"
                  Foreground="#D8DEE9"
                  IsExpanded="False">
            <TextBox x:Name="RawDumpTextBox"
                     Height="126"
                     Margin="0,6,0,0"
                     Padding="8"
                     FontFamily="Consolas"
                     FontSize="12"
                     HorizontalScrollBarVisibility="Auto"
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" />
        </Expander>

        <Grid Grid.Row="5" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Foreground="#9AA3B2" Text="Ready." />
            <TextBlock x:Name="LastUpdateText" Grid.Column="1" Foreground="#9AA3B2" />
        </Grid>
    </Grid>
</Window>
