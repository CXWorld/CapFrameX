<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <OutputType>Library</OutputType>
    <RootNamespace>CapFrameX.PmcReader.Plugin</RootNamespace>
    <AssemblyName>CapFrameX.PmcReader.Plugin</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- This project deliberately compiles a curated subset of the PmcReader
         sources; default globbing would also pick up the test app and forms
         that are not part of the plugin. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="2.9.0" />
    <!-- Keep in step with LibreHardwareMonitorLib to avoid restore-time downgrades. -->
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
  </ItemGroup>
  <!-- Plugin source files -->
  <ItemGroup>
    <Compile Include="PmcReaderInterop.Forwarder.cs" />
    <Compile Include="PmcReaderLogging.cs" />
    <Compile Include="PmcReaderSensorEntry.cs" />
    <Compile Include="PmcReaderSensorPlugin.cs" />
