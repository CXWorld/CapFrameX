<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <!-- Drives the same x64-only driver interop as PmcReader itself. -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>PmcReader.TestApp</RootNamespace>
    <AssemblyName>PmcReader.TestApp</AssemblyName>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- WMI moved out of the platform on .NET; MainWindow queries it directly. -->
    <PackageReference Include="System.Management" Version="10.0.11" />
    <PackageReference Include="System.Reactive" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\source\CapFrameX.Contracts\CapFrameX.Contracts.csproj" />
    <ProjectReference Include="..\CapFrameX.PmcReader.Plugin.csproj" />
  </ItemGroup>

</Project>
